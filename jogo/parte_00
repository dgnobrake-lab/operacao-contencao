// ===== SANGUE: gotas no ar + manchas no chao (giram junto com o mapa) =====
const blood=[],drops=[];
function splash(x,y,r,a,life){blood.push({x,y,r,a,t:0,life:life||70});if(blood.length>260)blood.shift();}
function bleed(b,a,dead){
 if(!dead)return;                       // ferido não sangra; só ao morrer, e com metade do volume
 if(b.inCar)return;                     // quem está dentro do veículo não suja o veículo
 for(const c of cars){if(c.dead||!isPol(c))continue;if(carDist(c,b.x,b.y)<1.2)return;}   // nada de sangue sobre viatura ou Caveirão
 const dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1,ux=dx/d,uy=dy/d,n=9;
 for(let i=0;i<n;i++){const sp=rr(.7,2.9),an=rr(-.7,.7),c=Math.cos(an),s=Math.sin(an);drops.push({x:b.x,y:b.y,z:b.z+rr(10,24),vx:(ux*c-uy*s)*sp,vy:(ux*s+uy*c)*sp,vz:rr(20,95),r:rr(.8,1.7),t:0});}
 if(!(b.z>0)){splash(b.x+ux*.18,b.y+uy*.18,rr(.07,.13),.8);if(dead)for(let i=0;i<4;i++)splash(b.x+rr(-.14,.14),b.y+rr(-.14,.14),rr(.2,.38),.85);}}
// tiro do BOPE na cabeça: névoa vermelha + jato de gotas saindo pelo lado oposto ao atirador
const bursts=[];
function headBurst(b,a,dead){const dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1,ux=dx/d,uy=dy/d,hz=(b.z||0)+37;
 bursts.push({x:b.x,y:b.y,z:hz,ux,uy,t:0,big:dead});
 const n=dead?42:26;for(let i=0;i<n;i++){const back=Math.random()<.8,sp=back?rr(1.6,4.6):rr(.5,1.6),an=rr(-.95,.95),c=Math.cos(an),s=Math.sin(an),sx=back?1:-1;
  drops.push({x:b.x,y:b.y,z:hz+rr(-3,3),vx:(ux*c-uy*s)*sp*sx,vy:(ux*s+uy*c)*sp*sx,vz:rr(25,150),r:rr(.9,2.3),t:0});}
 if(!(b.z>0)){for(let i=0;i<(dead?6:3);i++)splash(b.x+ux*rr(.3,1.1)+rr(-.2,.2),b.y+uy*rr(.3,1.1)+rr(-.2,.2),rr(.08,.2),.85);if(dead)splash(b.x,b.y,rr(.28,.4),.9);}}
function updBlood(dt){for(let i=bursts.length-1;i>=0;i--){bursts[i].t+=dt;if(bursts[i].t>.45)bursts.splice(i,1);}for(let i=drops.length-1;i>=0;i--){const d=drops[i];d.t+=dt;d.vz-=300*dt;d.z+=d.vz*dt;d.x+=d.vx*dt;d.y+=d.vy*dt;{const gl=hillLift(d.x,d.y);if(d.z>gl)continue;if(gl>0){drops.splice(i,1);continue;}}if(d.z<=0){if(Math.random()<.8)splash(d.x,d.y,rr(.035,.09),.75);drops.splice(i,1);}}
 for(let i=blood.length-1;i>=0;i--){blood[i].t+=dt;if(blood[i].t>blood[i].life)blood.splice(i,1);}}
function drawBlood(vx0,vx1,vy0,vy1){for(const b of blood){const sx=(b.x-b.y)*S,sy=(b.x+b.y)*16;if(sx<vx0||sx>vx1||sy<vy0||sy>vy1)continue;
