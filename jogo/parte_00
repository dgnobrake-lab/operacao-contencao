function ocSnpcAlvo(u,timeAlvo){
  const A=(typeof M3!=='undefined')?M3.A:null;if(!A)return null;
  const MPU=OC_WORLD.MPU,T=A.THREE;
  const alt=(u._alt||0),oy=A.th(u.x,u.y)+alt+(typeof ocEye==='function'?ocEye(u):1.5/MPU);
  const o=new T.Vector3(u.x,oy,u.y);
