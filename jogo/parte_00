// ===================== v78: O SNIPER DA PM SOBE NO TELHADO E TRABALHA =====================
// Quando há ação policial com o BOPE em campo, o atirador de elite que não está sendo controlado procura
// uma escada perto do tiroteio, sobe na laje, se posiciona e passa a abater alvos a distância — que é o que
// um sniper faz. Na laje ele tem linha de visada de verdade: a checagem é um raio em 3D saindo da altura do
// telhado, não o alcance plano da IA comum.
const OC_SNPC={ligado:true,alcanceM:420,cadencia:2.4,raioAcao:30,stats:{subiram:0,tiros:0,semEscada:0},_t:0};
function ocSnpcAcao(){
  // centro da ação: BOPE (ou PM) com inimigo vivo por perto
  if(typeof units==='undefined')return null;
  let bope=null,n=0,sx=0,sy=0;
  for(const u of units){
    if(u.dead||u.team!=='P')continue;
    const eBope=!!(u.rgSpec||u.sub==='bope');
    if(!eBope)continue;
    bope=bope||u;
    // inimigo vivo por perto?
    for(const e of units){
      if(e.dead||e.team!=='E'||e.surr||e.preso)continue;
      if(Math.hypot(e.x-u.x,e.y-u.y)>OC_SNPC.raioAcao)continue;
      sx+=e.x;sy+=e.y;n++;break;}}
  if(!bope||!n)return null;
  return{x:sx/n,y:sy/n,bope};}
function ocSnpcEscadaPara(u,acao){
  const L=(window.OC_ESC&&OC_ESC.lista)||[];if(!L.length)return null;
  let melhor=null,ms=-1e9;
  for(const e of L){
    const dAcao=Math.hypot(e.roofX-acao.x,e.roofY-acao.y);
    if(dAcao>34||dAcao<5)continue;                 // nem longe demais nem em cima do tiroteio
    const dEu=Math.hypot(e.x-u.x,e.y-u.y);
    if(dEu>60)continue;
    // perigo: inimigo colado na escada
    let perigo=0;for(const q of units){if(q.dead||q.team!=='E')continue;if(Math.hypot(q.x-e.x,q.y-e.y)<5){perigo=1;break;}}
    if(perigo)continue;
