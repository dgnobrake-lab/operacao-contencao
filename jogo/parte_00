function ocOnMeuBoneco(){
  try{const F=window.FPS,D=window.OC_DIRECT;
    if(F&&F.on&&F.u)return F.u;
    if(D&&D.u)return D.u;
    if(typeof sel!=='undefined'&&sel&&sel.length&&!sel[0].isCar)return sel[0];
    if(typeof units!=='undefined')return units.find(u=>!u.dead&&!u.inCar&&u.team===((window.GAME_MODE==='traficante')?'E':'P'));
  }catch(_){}
  return null;}
// leva o meu personagem para o lado do outro jogador (e a câmera junto)
function ocOnIrAte(id){
  const J=ocOnJog();if(!J)return false;
  const j=J.get(id);if(!j)return false;
  const u=ocOnMeuBoneco();if(!u){ocOnMsg('Selecione um personagem primeiro');return false;}
  const A=(typeof M3!=='undefined')?M3.A:null;
  // procura um ponto andável do lado dele
  let dx=0,dy=0,achou=false;
  for(let r=1;r<=6&&!achou;r++){
    for(const [ax,ay] of [[r,0],[-r,0],[0,r],[0,-r],[r,r],[-r,-r],[r,-r],[-r,r]]){
      const nx=j.x+ax*0.6,ny=j.y+ay*0.6;
      let ok=true;try{if(typeof walk==='function')ok=walk(nx|0,ny|0);}catch(_){}
      if(ok){dx=nx;dy=ny;achou=true;break;}}}
  if(!achou){dx=j.x+1.2;dy=j.y;}
  try{if(u.inCar&&typeof leaveCar==='function')leaveCar(u);}catch(_){}
  u.x=dx;u.y=dy;u.path=[];u.order={t:'idle'};
  try{if(u._lajeEsc){u._lajeEsc=null;u._alt=0;u.roof=0;}}catch(_){}
  try{if(typeof centerOn==='function')centerOn([u]);}catch(_){}
  ocOnMsg('Você apareceu ao lado de '+(j.nome||'ele'));
  return true;}
