function ocFutCampos(){
  const S=OC_FUT;if(S.campos.length)return S.campos;
  const A=M3.A;if(!A)return S.campos;
  // campo da cidade
  try{const f=window.__ocFeat&&__ocFeat().field;
    if(f)S.campos.push({nome:'cidade',x:f.x,y:f.y,w:f.w,h:f.h});}catch(_){}
  // campo do alto: o retângulo do morro está em coordenadas da imagem do morro
  try{const H=window.__ocHFLD&&__ocHFLD();
    if(H&&typeof HC!=='undefined'&&typeof HK!=='undefined'){
      const x0=HC+H.x0*HK,x1=HC+H.x1*HK,y0=HC+H.y0*HK,y1=HC+H.y1*HK;
      if(isFinite(x0)&&x1>x0)S.campos.push({nome:'morro',x:Math.min(x0,x1),y:Math.min(y0,y1),
