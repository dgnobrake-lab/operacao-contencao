    if(b){P.cop=b;b.prisao=P;b.path=[];b.order={t:'prisao'};toast((u.boss?'Dono do Morro':'Gerente')+' rendido — policial fazendo a abordagem');}else break;}
   const c2=P.cop;// policial se aproxima por trás do preso
