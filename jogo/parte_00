   else if(t<1.9){c.porta=1;const k=(t-.7)/1.2;u.x=P.from.x+(r.x-P.from.x)*Math.min(1,k*1.4);u.y=P.from.y+(r.y-P.from.y)*Math.min(1,k*1.4);
     if(k>.55){const m=(k-.55)/.45;u.x=r.x+(c.x-r.x)*m*.5;u.y=r.y+(c.y-r.y)*m*.5;}P.alpha=1-Math.max(0,(k-.6)/.4);u.fx=c.x-u.x;u.fy=c.y-u.y;u.mv=true;u.ph=(u.ph||0)+dt*5;cop.fx=u.x-cop.x;cop.fy=u.y-cop.y;}
   else if(t<2.6){if(!u.inCar){u.inCar=c;c.preso=u;P.alpha=0;}c.porta=Math.max(0,1-(t-1.9)/.6);cop.fx=r.x-cop.x;cop.fy=r.y-cop.y;}
