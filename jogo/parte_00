// ===================== v75/76: Corolla da PMERJ como segunda viatura da PM =====================
// A frota da PM tinha um modelo só. Agora parte das viaturas usa o Corolla que o usuário mandou.
// As viaturas do começo da partida já vêm montadas pelo mapa (não passam pelo sorteio de modelo),
// então aqui a malha delas é trocada em cena: a lógica continua a mesma (capacidade, ordens, giroflex),
// só muda o 3D. O giroflex é remontado depois da troca, para acender nas lanternas do carro novo.
const OC_PMCAR={modelo:'pmcorolla',fatia:0.5,stats:{corolla:0,padrao:0,trocadas:0},_t:0,_motivo:''};
function ocPmEscolhido(c){
  if(c._pmMod===undefined){
    const A=(typeof M3!=='undefined'&&M3.A)?M3.A:null;
    const tem=!!(A&&A.tpl&&A.tpl[OC_PMCAR.modelo]);
    c._pmMod=(tem&&((c.id|0)%2===0))?1:0;      // metade da frota, de forma estável
    if(c._pmMod)OC_PMCAR.stats.corolla++;else OC_PMCAR.stats.padrao++;}
  return c._pmMod===1;}
window.__ocPmModelo=function(c){
  try{if(!c||c.sub!=='pm')return 'pm';return ocPmEscolhido(c)?OC_PMCAR.modelo:'pm';}catch(_){return 'pm';}};
// troca a malha das viaturas que o mapa já montou
function ocPmTrocar(dt){
  const ag=performance.now();if(ag-OC_PMCAR._t<1200)return;OC_PMCAR._t=ag;
  const A=(typeof M3!=='undefined'&&M3.A)?M3.A:null;
  const G=window.__game;const lista=(typeof cars!=='undefined')?cars:(G&&G.cars)||null;
  if(!A||!A.tpl||!A.tpl[OC_PMCAR.modelo]||!lista){OC_PMCAR._motivo=!A?'sem A':(!A.tpl?'sem tpl':(!A.tpl[OC_PMCAR.modelo]?'sem modelo':'sem lista'));return;}
  OC_PMCAR._motivo='';
  const t=A.tpl[OC_PMCAR.modelo];
  for(const c of lista){
    if(c.sub!=='pm'||c.dead||c._pmTrocado||!c._m3m)continue;
    if(!ocPmEscolhido(c)){c._pmTrocado=1;continue;}
    try{
      const velho=c._m3m,pai=velho.parent;if(!pai){continue;}
      const novo=t.m.clone(true);
      novo.position.copy(velho.position);novo.rotation.order='YXZ';novo.rotation.copy(velho.rotation);
      novo.visible=velho.visible;
      pai.add(novo);pai.remove(velho);
      c._m3m=novo;c._m3off=t.off;c._m3scaled=false;c._m3gfix=null;c._selDim=null;
      c._giro=null;c._giroM=null;   // giroflex refeito no modelo novo
      if(window.__ocVehFix)window.__ocVehFix('pm',c,novo);
      if(M3.normalizeVehicleScale){M3.normalizeVehicleScale(novo,c.sub);c._m3scaled=true;}
      c._pmTrocado=1;OC_PMCAR.stats.trocadas++;
    }catch(_){c._pmTrocado=1;}}}
window.__ocPmTrocar=ocPmTrocar;window.OC_PMCAR=OC_PMCAR;

// ===================== v76: tela limpa quando a luneta está aberta =====================
// Com a luneta aberta a tela ficava cheia de botão por cima: PULAR, AGACHAR, REFORÇO, aviso de rede, placa do
// modo de jogo — tudo em volta da mira, e ainda sobreposto. Mirando, só fica o que se usa ali:
// a mira, o disparo, o zoom, a zeragem e a distância. Ao sair da luneta tudo volta ao normal.
