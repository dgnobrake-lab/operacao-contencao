function policeDir(u){const vx=(u.fx-u.fy)*S,vy=(u.fx+u.fy)*16;if(Math.abs(vx)+Math.abs(vy)<1e-4)return u._pd|0;let a=Math.atan2(-vx,vy)*180/Math.PI;if(a<0)a+=360;a=a%360;
