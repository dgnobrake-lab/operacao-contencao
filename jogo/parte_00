// ===================== v78: ESCADAS DE VERDADE NOS BARRACOS =====================
// Antes as escadas eram cenário: ninguém subia. Agora elas levam ao telhado — e por elas sobem tanto o
// jogador quanto o sniper da PM. Duas peças novas (escada de incêndio e escada vertical) entram nos
// barracos em pontos escolhidos: parede com chão andável encostado, laje de 1 a 3 andares e distância
// mínima entre uma escada e outra. No telhado o personagem fica preso à laje — o corrimão não é
// atravessado: para descer, usa a escada.
const OC_ESC={tpl:{},carregou:false,carregando:false,colocou:false,lista:[],
  altura:{escada_incendio:4.0,escada_vertical:2.4},   // altura real do modelo, em metros
  subida:2.6,                                         // segundos para vencer um lance
  stats:{incendio:0,vertical:0,existentes:0,subidas:0,descidas:0},_f:0};
// ---------- modelos ----------
function ocEscCarregar(){
  const S=OC_ESC,A=(typeof M3!=='undefined')?M3.A:null;
  if(S.carregou||S.carregando||!A||!A.parseGltf)return;
  const el=document.getElementById('oc-escadas78');if(!el)return;S.carregando=true;
  (async()=>{try{
    const D=JSON.parse(el.textContent),T=A.THREE;
    await Promise.all(Object.keys(D).map(async k=>{
      const raw=Uint8Array.from(atob(D[k]),c=>c.charCodeAt(0));
      const bytes=await ocGunzip(raw);
      const g=await A.parseGltf(bytes);const root=g.scene;root.updateMatrixWorld(true);
      root.traverse(o=>{if(o.isMesh){o.castShadow=false;o.receiveShadow=false;o.raycast=()=>{};if(o.material)o.material.metalness=0;}});
      const bb=new T.Box3().setFromObject(root),sz=bb.getSize(new T.Vector3()),c=bb.getCenter(new T.Vector3());
      const wrap=new T.Group();root.position.set(-c.x,-bb.min.y,-c.z);wrap.add(root);
      S.tpl[k]={obj:wrap,h:sz.y||1,sx:sz.x,sz:sz.z};}));
    S.carregou=true;
    console.log('[escadas78] modelos',Object.keys(S.tpl).map(k=>k+' h='+S.tpl[k].h.toFixed(3)).join(', '));
  }catch(e){console.warn('escadas78',e);}})();}
// ---------- onde cabe uma escada ----------
function ocEscCandidatos(){
  const out=[];
  if(typeof lots==='undefined')return out;
  for(const L of lots){
    if(L.rock||L.wall||L.roof!==1||!(L.fl>=1&&L.fl<=3))continue;
    const cx=L.x+L.w/2,cy=L.y+L.h/2;
    // lados com chão andável encostado; conta quantas células seguidas são livres (a de incêndio é larga)
    const lados=[[cx,L.y-.5,0,-1],[cx,L.y+L.h+.5,0,1],[L.x-.5,cy,-1,0],[L.x+L.w+.5,cy,1,0]];
    for(const sd of lados){
      const gx=sd[0]|0,gy=sd[1]|0;
      if(!(inb(gx,gy)&&walk(gx,gy)))continue;
      let largo=0;const px=sd[3]!==0?1:0,py=sd[3]!==0?0:1;   // ao longo da parede
      for(let i=-1;i<=1;i++){const ax=gx+px*i,ay=gy+py*i;if(inb(ax,ay)&&walk(ax,ay))largo++;}
      out.push({L,sd,largo,cx,cy});
      break;}}
  return out;}
function ocEscColocar(){
  const S=OC_ESC;
  if(S.colocou||!S.carregou)return;
  const A=M3.A;if(!A||typeof lots==='undefined')return;
  S.colocou=true;
  const MPU=OC_WORLD.MPU,usadas=[];
  // as escadas que já existiam (cenário v58) entram na mesma lista e passam a funcionar
  try{for(const l of (window.OC_P58&&OC_P58.ladders)||[]){
    const alt=Math.max(.2,A.bldAt(l.roofX,l.roofY)-A.th(l.roofX,l.roofY));
    S.lista.push({x:l.x,y:l.y,nx:l.nx,ny:l.ny,L:l.L,alt,roofX:l.roofX,roofY:l.roofY,modelo:'escada',obj:l.obj,
      peX:Math.floor(l.x+l.nx*.7)+.5,peY:Math.floor(l.y+l.ny*.7)+.5});
    usadas.push([l.x,l.y]);S.stats.existentes++;}}catch(_){}
  const cand=ocEscCandidatos();
  // espalha: quem está mais longe de uma escada já posta entra primeiro
  cand.sort((a,b)=>(b.largo-a.largo)||(Math.random()-.5));
  for(const c of cand){
    if(S.lista.length>=34)break;
    const [sx,sy,nx,ny]=c.sd;
    if(usadas.some(u=>Math.hypot(u[0]-sx,u[1]-sy)<7))continue;
    const L=c.L,wallX=sx-nx*.5,wallY=sy-ny*.5;
    const roofX=wallX-nx*.45,roofY=wallY-ny*.45;
    const alt=Math.max(.2,A.bldAt(roofX,roofY)-A.th(roofX,roofY));
    if(alt<.3)continue;                                  // laje baixa demais: não vale escada
    const hM=alt*MPU+.9;                                 // a escada passa um pouco da borda
    const modelo=(c.largo>=3&&hM<=6.5&&S.tpl.escada_incendio)?'escada_incendio':'escada_vertical';
    const t=S.tpl[modelo];if(!t)continue;
    const base=0.25/MPU;
    const x=wallX+nx*base,y=wallY+ny*base,yaw=Math.atan2(nx,ny);
    const o=t.obj.clone(true);
    const sy2=(hM/MPU)/t.h;                              // altura: estica no eixo vertical
    const sxz=Math.min(sy2,1.35/ (t.sx||1) * (1/MPU) * 10) || sy2;
    o.scale.set(modelo==='escada_vertical'?Math.min(sy2,sy2*.9):sy2, sy2, modelo==='escada_vertical'?Math.min(sy2,sy2*.9):sy2);
    o.position.set(x,A.th(x,y),y);o.rotation.y=yaw+(modelo==='escada_incendio'?Math.PI:0);
    A.scene.add(o);
    S.lista.push({x,y,nx,ny,L,alt,roofX,roofY,modelo,obj:o,peX:Math.floor(sx)+.5,peY:Math.floor(sy)+.5});
    usadas.push([x,y]);
    S[modelo==='escada_incendio'?'_i':'_v']=1;
    S.stats[modelo==='escada_incendio'?'incendio':'vertical']++;}
  console.log('[escadas78] escadas utilizáveis:',S.lista.length,JSON.stringify(S.stats));}
// ---------- usar a escada ----------
function ocEscPerto(x,y,raio){
  let melhor=null,md=raio||1.6;
  for(const e of OC_ESC.lista){const d=Math.hypot(e.x-x,e.y-y);if(d<md){md=d;melhor=e;}
    const dr=Math.hypot(e.roofX-x,e.roofY-y);if(dr<md){md=dr;melhor=e;}}
  return melhor;}
function ocEscNoTelhado(u){return !!(u&&u._lajeEsc);}
function ocEscSubir(u,e){
  if(!u||u.dead||u.inCar||u._esc)return false;
  e=e||ocEscPerto(u.x,u.y,1.8);if(!e)return false;
  if(u._lajeEsc)return false;
  u._esc={e,fase:'sobe',t:0,x0:u.x,y0:u.y};
  u.path=[];u.order={t:'hold'};u.mv=false;u.roof=1;   // fora do empurra-empurra e do atropelo enquanto sobe
  OC_ESC.stats.subidas++;return true;}
function ocEscDescer(u){
  if(!u||!u._lajeEsc||u._esc)return false;
  const e=u._lajeEsc;
  u._esc={e,fase:'desce',t:0};u.path=[];u.order={t:'hold'};u.mv=false;
  OC_ESC.stats.descidas++;return true;}
// o personagem gruda na escada, sobe no tempo do clipe e desembarca na laje
function ocEscTickUnidade(u,dt){
  const S=OC_ESC,st=u._esc;if(!st)return;
  const e=st.e,T=S.subida*Math.max(.6,Math.min(2.2,e.alt/1.3));
  st.t+=dt;
  const k=Math.min(1,st.t/T);
  const subindo=st.fase==='sobe';
  // encostado na escada durante a subida
  u.x+=((e.x)-u.x)*Math.min(1,dt*8);u.y+=((e.y)-u.y)*Math.min(1,dt*8);
  u._yaw=Math.atan2(-e.nx,-e.ny);u.fx=Math.sin(u._yaw);u.fy=Math.cos(u._yaw);
  u._alt=subindo?e.alt*k:e.alt*(1-k);
  u._escClip=true;u.mv=false;u.aim=0;
  if(k>=1){
    if(subindo){u._lajeEsc=e;u._alt=e.alt;u.x=e.roofX;u.y=e.roofY;u.roof=1;u._lajeTelX=u.x;u._lajeTelY=u.y;u._queda=0;u._voou=0;}
    else {u._lajeEsc=null;u._alt=0;u.roof=0;u._lajeTelX=null;u.x=e.x-e.nx*.35;u.y=e.y-e.ny*.35;}
    u._esc=null;u._escClip=false;}}
// ---------- andar pelos telhados ----------
// Altura do telhado (acima do terreno) em um ponto, ou null se ali não há laje.
function ocEscAltTelhado(x,y){
  const A=M3.A;if(!A||!A.bldAt)return null;
  const b=A.bldAt(x,y);if(b<=-900)return null;
  const t=A.th(x,y),a=b-t;
  return a>0.25?a:null;}
// Em cima: pode andar por todas as lajes vizinhas de altura parecida e PULAR de uma para outra.
// Na beirada sem laje do outro lado, o passo é barrado (é o corrimão); pulando, não.
function ocEscPrenderNaLaje(u){
  const e=u._lajeEsc;if(!e)return;
  u.roof=1;
  if(!u.order||u.order.t!=='hold')if(!u._escLivre)u.order={t:'hold'};
  // caindo de uma laje para o chão
  if(u._queda){
    u._alt=Math.max(0,(u._alt||0)-5.5*0.05);
    if(u._alt<=0.001){u._alt=0;u._queda=0;u._lajeEsc=null;u.roof=0;
      try{if(u.hp)u.hp=Math.max(1,u.hp-6);}catch(_){}}
    return;}
  const alt=ocEscAltTelhado(u.x,u.y);
  const noAr=!!u._air;
  if(noAr){                                   // no ar: deixa cruzar o vão
    u._alt=Math.max(u._alt||0,0);
    u._voou=1;
    try{u.z=(M3.A.th(u.x,u.y)+(u._alt||0))*PXH3;}catch(_){}
    return;}
  if(u._voou){                                // acabou de aterrissar
    u._voou=0;
    if(alt!=null){u._alt=alt;u._lajeTelX=u.x;u._lajeTelY=u.y;}
    else{u._queda=1;}
    return;}
  if(alt!=null&&Math.abs(alt-(u._alt||0))<0.42){
    u._alt=alt;u._lajeTelX=u.x;u._lajeTelY=u.y;          // passou para a laje vizinha
  }else if(alt!=null&&alt<(u._alt||0)){
    u._queda=1;                                         // pisou num vão mais baixo: desce
  }else{
    // beirada: volta para o último ponto bom da laje
    if(u._lajeTelX!=null){u.x=u._lajeTelX;u.y=u._lajeTelY;}
    else{u.x=e.roofX;u.y=e.roofY;u._lajeTelX=u.x;u._lajeTelY=u.y;}}
  try{u.z=(M3.A.th(u.x,u.y)+(u._alt||0))*PXH3;}catch(_){}}
// chamado no fim do quadro, depois que todo mundo já andou
function ocEscFixar(){
  if(typeof units==='undefined')return;
