function posiciona(){const els=FLUT.map(i=>document.getElementById(i)).filter(visivel);if(!els.length)return;
  const obs=obstaculos(els),W=innerWidth,H=innerHeight,M=8,ocup=[];
  for(const el of els){const r=el.getBoundingClientRect(),w=Math.ceil(r.width)+(el.id==='ocMpLuz'?40:4),h=Math.max(Math.ceil(r.height),el.id==='ocMpLuz'?30:0)+4;
