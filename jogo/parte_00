// ===================== v74: LEVOU TIRO — sente e vê de onde veio =====================
// Antes o jogador morria de longe sem nenhum aviso. Agora, ao ser atingido:
//  • a tela ganha uma mancha vermelha nas bordas, mais forte quanto maior o dano;
//  • a imagem treme por um instante;
//  • setas vermelhas em volta da mira apontam de onde veio cada tiro, com a distância e quem atirou.
const OC_DANO={marcas:[],dur:4.0,el:null,aviso:null,vinheta:null,
  vinh:0,tremor:0,stats:{avisos:0,baques:0}};
function ocDanoJog(){const F=window.FPS,D=window.OC_DIRECT;
  if(F&&F.on&&F.u)return F.u;if(D&&D.u)return D.u;if(F&&F.u)return F.u;return null;}
function ocDanoCria(){
  if(OC_DANO.el&&document.body.contains(OC_DANO.el))return;
  const v=document.createElement('div');v.id='ocDanoVinheta';
  v.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:25;opacity:0;transition:opacity .12s;'+
    'background:radial-gradient(ellipse at center,rgba(255,0,0,0) 38%,rgba(190,0,0,.30) 72%,rgba(130,0,0,.72) 100%)';
  document.body.appendChild(v);OC_DANO.vinheta=v;
  const d=document.createElement('div');d.id='ocDanoDir';
  d.style.cssText='position:fixed;inset:0;pointer-events:none;z-index:26;display:none';
  document.body.appendChild(d);OC_DANO.el=d;
  const a=document.createElement('div');a.id='ocDanoAviso';
  a.style.cssText='position:fixed;left:50%;top:60%;transform:translateX(-50%);pointer-events:none;z-index:27;'+
    'font:700 13px "Segoe UI",Arial,sans-serif;color:#ff6b5b;text-shadow:0 1px 3px #000;display:none;text-align:center';
  document.body.appendChild(a);OC_DANO.aviso=a;}
// chamado quando alguém é ferido; só interessa quando o ferido é quem o jogador controla
function ocDanoDir(b,o){
  if(!b)return;const eu=ocDanoJog();if(!eu||b!==eu)return;
  ocDanoCria();
  const dano=Math.max(1,(o&&o.dmg)||8);
  OC_DANO.vinh=Math.min(1,OC_DANO.vinh+.35+Math.min(.5,dano/60));   // mancha vermelha
  OC_DANO.tremor=Math.min(1,OC_DANO.tremor+.5+Math.min(.5,dano/50));// tremor da imagem
  OC_DANO.stats.baques++;
  const a=o&&o.shooter;if(!a||a.x==null)return;
  const dM=Math.hypot(a.x-b.x,a.y-b.y)*OC_WORLD.MPU;
  OC_DANO.marcas.push({x:a.x,y:a.y,t:OC_DANO.dur,distM:dM,
    nome:(a.sub==='bope'?'BOPE':a.team==='E'?'suspeito':a.team==='P'?'policial':'alguém')});
  if(OC_DANO.marcas.length>6)OC_DANO.marcas.shift();
  OC_DANO.stats.avisos++;}
// a cada quadro: apaga a mancha, sacode a tela e desenha as setas
function ocDanoTick(dt){
  dt=Math.min(.1,dt||.016);ocDanoCria();
  const eu=ocDanoJog();
  OC_DANO.vinh=Math.max(0,OC_DANO.vinh-dt*1.1);
  OC_DANO.tremor=Math.max(0,OC_DANO.tremor-dt*3.2);
  for(let i=OC_DANO.marcas.length-1;i>=0;i--){OC_DANO.marcas[i].t-=dt;if(OC_DANO.marcas[i].t<=0)OC_DANO.marcas.splice(i,1);}
  if(OC_DANO.vinheta)OC_DANO.vinheta.style.opacity=(OC_DANO.vinh*.95).toFixed(3);
  // tremor: mexe o canvas do jogo por um instante
  const cv=document.querySelector('canvas');
  if(cv){if(OC_DANO.tremor>.002){const k=OC_DANO.tremor*7;
      cv.style.transform='translate('+(Math.random()*2-1)*k+'px,'+(Math.random()*2-1)*k+'px)';}
    else if(cv.style.transform)cv.style.transform='';}
  const el=OC_DANO.el;
  if(!eu||!OC_DANO.marcas.length){if(el)el.style.display='none';if(OC_DANO.aviso)OC_DANO.aviso.style.display='none';return;}
  const F=window.FPS;let cam=0;
  if(F&&F.on)cam=F.yaw;
  else if(window.OC_GTA&&window.OC_GTA.yaw!=null)cam=window.OC_GTA.yaw;
  else cam=Math.atan2(eu.fy||0,eu.fx||1);
  let html='';let perto=null;
  for(const m of OC_DANO.marcas){
    const ang=Math.atan2(m.y-eu.y,m.x-eu.x)-cam;   // 0 = na frente
    const a=Math.max(0,Math.min(1,m.t/OC_DANO.dur));
    const r=Math.min(innerWidth,innerHeight)*0.26;
    const cx=innerWidth/2+Math.sin(ang)*r, cy=innerHeight/2-Math.cos(ang)*r*0.72;
    html+='<div style="position:absolute;left:'+cx.toFixed(0)+'px;top:'+cy.toFixed(0)+'px;'+
      'transform:translate(-50%,-50%) rotate('+(ang*180/Math.PI).toFixed(0)+'deg);opacity:'+a.toFixed(2)+';'+
      'width:0;height:0;border-left:13px solid transparent;border-right:13px solid transparent;'+
      'border-bottom:26px solid rgba(255,70,55,.92);filter:drop-shadow(0 0 3px #000)"></div>';
    if(!perto||m.distM<perto.distM)perto=m;}
  el.innerHTML=html;el.style.display='block';
  if(OC_DANO.aviso&&perto){OC_DANO.aviso.textContent='tiro de '+perto.nome+' a '+Math.round(perto.distM)+' m';
    OC_DANO.aviso.style.display='block';OC_DANO.aviso.style.opacity=Math.max(0,Math.min(1,perto.t/OC_DANO.dur)).toFixed(2);}}
window.__ocDanoDir=ocDanoDir;window.__ocDanoTick=ocDanoTick;window.OC_DANO=OC_DANO;

// ===================== v74: mouse guia o olhar na 3ª pessoa (PC) + reforço do BOPE vem na caçamba =====================
// 3ª pessoa no PC: antes só dava para girar a câmera arrastando (feito para toque). Agora o mouse guia o olhar:
// clique uma vez na tela para prender o ponteiro e mova o mouse; Esc solta. No celular continua por arrasto.
const OC_MOUSE={preso:false,sens:.0026,sensY:.0021,stats:{entrou:0}};
function ocMouseLook(){
  const toque=!!(window.__ocTouchUI||matchMedia('(pointer:coarse)').matches);
  const G=()=>window.OC_GTA;
  const cv=()=>document.querySelector('canvas');
  addEventListener('mousedown',e=>{
    const g=G();if(!g||!g.on||toque)return;
    if(e.target&&e.target.closest&&e.target.closest('button,#ocGTcam,#ocGTzone,.btn,#menu'))return;
    if(document.pointerLockElement)return;
    const c=cv();if(c&&c.requestPointerLock){try{c.requestPointerLock();OC_MOUSE.stats.entrou++;}catch(_){}}},true);
  document.addEventListener('pointerlockchange',()=>{OC_MOUSE.preso=!!document.pointerLockElement;});
  addEventListener('mousemove',e=>{
    const g=G();if(!g||!g.on||!document.pointerLockElement)return;
    g.yaw-=(e.movementX||0)*OC_MOUSE.sens;
    const dy=(e.movementY||0)*OC_MOUSE.sensY;
    if(g.ff)g.lp=Math.max(-.6,Math.min(.55,(g.lp||0)-dy));
    else g.pitch=Math.max(.15,Math.min(1.25,(g.pitch||.5)-dy));});
  // sair da 3ª pessoa solta o ponteiro
  setInterval(()=>{const g=G();if(document.pointerLockElement&&(!g||!g.on)){try{document.exitPointerLock();}catch(_){}}},600);
}
try{ocMouseLook();}catch(_){}
window.OC_MOUSE=OC_MOUSE;
// ---- reforço: quando a viatura é a Ranger do BOPE, a guarnição vai na caçamba ----
window.__ocRefCacamba=function(c){
  try{if(!c||c.sub!=='ranger')return 0;
    if(!c.open&&typeof rangerSetOpen==='function')rangerSetOpen(c,true);
    let n=0;for(const u of (c.pass||[])){if(u.rgSpec)continue;
      if(u.team!=='P')continue;
      u.rgSpec=1;u.sub='bope';   // quem chega na Ranger é BOPE e senta na caçamba
      const usados=(c.pass||[]).filter(q=>q!==u&&q.bedSlot!=null).map(q=>q.bedSlot);
      const livres=[0,1,2,3,4].filter(i=>!usados.includes(i));
      u.bedSlot=livres.length?livres[0]:0;n++;}
    return n;}catch(_){return 0;}};

// ===================== v75: PARTIDA NA REDE LOCAL (LAN) — primeira versão =====================
// O jogo é um HTML só, então quem organiza a partida é um servidor leve rodando num PC da mesma Wi-Fi
// (arquivo `servidor_lan.js`, sem instalar bibliotecas). Os celulares abrem o endereço do PC e já entram.
// Pela rede trafegam SÓ os jogadores (posição, giro, animação, veículo e tiros): o mapa é o mesmo em todos
// porque a semente é combinada na sala, e a IA roda em cada aparelho. Isso mantém o consumo baixo.
// Nada disso altera o jogo de um jogador só: sem sala, tudo continua como antes.
const OC_MP={
  via:null,          // null | 'lan' | 'online'
  lig:false,ws:null,id:null,nome:'',sala:null,host:false,max:10,
  jog:new Map(),            // id -> {id,nome,modo,u,alvo:{x,y,yaw},ultimo}
  salas:[],estado:'desligado',   // desligado | ligando | ligado | sala | caiu
  envioMs:100,_t:0,_tent:0,_reconn:null,ping:null,_pingT:0,
  stats:{enviados:0,recebidos:0,quedas:0,reconexoes:0},
  servidor:null
};
// endereço do servidor: se o jogo veio por http://, é o mesmo host; se veio do disco, o jogador digita
function ocMpEndereco(){
  try{if(location.protocol==='http:'||location.protocol==='https:')
    return (location.protocol==='https:'?'wss://':'ws://')+location.host+'/';}catch(_){}
  return OC_MP.servidor||null;}
function ocMpMsg(txt){try{if(typeof toast==='function')toast(txt);}catch(_){}
  const e=document.getElementById('ocMpAviso');if(e){e.textContent=txt;e.style.display='block';
    clearTimeout(e._t);e._t=setTimeout(()=>{e.style.display='none';},4000);}}
// ---------------- conexão ----------------
function ocMpConectar(endereco){
  // v83: com a partida online ligada, o cliente da rede local não entra no caminho
  // (ele estava roubando o OC_MP e a posição parava de ser enviada)
  if(OC_MP.via==='online')return false;
  const url=endereco||ocMpEndereco();
  if(!url){ocMpMsg('Informe o endereço do servidor (ex.: 192.168.0.10:8080)');return false;}
  OC_MP.servidor=url;OC_MP.via='lan';
  try{if(OC_MP.ws){OC_MP.ws.onclose=null;OC_MP.ws.close();}}catch(_){}
  OC_MP.estado='ligando';ocMpPainel();
  let ws;try{ws=new WebSocket(url);}catch(e){OC_MP.estado='caiu';ocMpMsg('Endereço inválido');ocMpPainel();return false;}
  OC_MP.ws=ws;
  ws.onopen=()=>{OC_MP.estado='ligado';OC_MP._tent=0;
    ocMpEnviar({t:'ola',nome:OC_MP.nome||('Jogador '+Math.floor(Math.random()*900+100))});
    ocMpEnviar({t:'listar'});ocMpPainel();};
  ws.onmessage=ev=>{OC_MP.stats.recebidos++;let m;try{m=JSON.parse(ev.data);}catch(_){return;}ocMpRecebeu(m);};
  ws.onclose=()=>{const tinha=OC_MP.estado==='sala';OC_MP.estado='caiu';OC_MP.stats.quedas++;
    ocMpLimparRemotos();ocMpPainel();if(tinha)ocMpMsg('Conexão caiu — tentando voltar…');ocMpReconectar();};
  ws.onerror=()=>{};
  return true;}
function ocMpReconectar(){
  if(OC_MP._reconn)return;
  const espera=Math.min(8000,1000*Math.pow(1.6,OC_MP._tent++));
  OC_MP._reconn=setTimeout(()=>{OC_MP._reconn=null;
    if(OC_MP.estado==='caiu'&&OC_MP.servidor){OC_MP.stats.reconexoes++;
      const codigo=OC_MP.sala&&OC_MP.sala.codigo;OC_MP._voltarPara=codigo;ocMpConectar(OC_MP.servidor);}},espera);}
function ocMpEnviar(o){
  if(OC_MP.via==='online')return window.__ocOnEnviar?window.__ocOnEnviar(o):false;   // v78: mesma rotina, transporte online
  const ws=OC_MP.ws;if(!ws||ws.readyState!==1)return false;
  try{ws.send(JSON.stringify(o));OC_MP.stats.enviados++;return true;}catch(_){return false;}}
function ocMpDesligar(){
  try{if(OC_MP.ws){OC_MP.ws.onclose=null;ocMpEnviar({t:'sair'});OC_MP.ws.close();}}catch(_){}
  OC_MP.ws=null;OC_MP.sala=null;OC_MP.estado='desligado';OC_MP.lig=false;
  clearTimeout(OC_MP._reconn);OC_MP._reconn=null;ocMpLimparRemotos();ocMpPainel();}
// ---------------- mensagens ----------------
function ocMpRecebeu(m){
  switch(m.t){
    case 'ola':OC_MP.id=m.id;OC_MP.max=m.max||10;OC_MP.salas=m.salas||[];
      if(OC_MP._voltarPara){const c=OC_MP._voltarPara;OC_MP._voltarPara=null;
        ocMpEnviar({t:'entrar',codigo:c,modo:window.GAME_MODE||'policia'});}
      ocMpPainel();break;
    case 'salas':OC_MP.salas=m.salas||[];ocMpPainel();break;
    case 'entrou':{
      OC_MP.sala={codigo:m.codigo,nome:m.nome,semente:m.semente};OC_MP.host=!!m.host;OC_MP.estado='sala';OC_MP.lig=true;
      ocMpLimparRemotos();
      for(const j of (m.jogadores||[]))if(j.id!==OC_MP.id)ocMpAdd(j);
      ocMpMsg('Na sala '+m.codigo+' · '+(m.jogadores?m.jogadores.length:1)+'/'+OC_MP.max+(OC_MP.host?' (você é o host)':''));
      ocMpSemente(m.semente);ocMpPainel();break;}
    case 'chegou':ocMpAdd(m);ocMpMsg(m.nome+' entrou na partida');ocMpPainel();break;
    case 'saiu':{const j=OC_MP.jog.get(m.id);if(j){ocMpRemover(m.id);ocMpMsg((j.nome||'Jogador')+' saiu');}ocMpPainel();break;}
    case 'novoHost':OC_MP.host=(m.id===OC_MP.id);ocMpMsg('Host agora: '+m.nome);ocMpPainel();break;
    case 'estado':{const j=OC_MP.jog.get(m.id);if(j){j.alvo=m.e;j.ultimo=performance.now();}break;}
    case 'evento':ocMpEvento(m.id,m.ev);break;
    case 'pong':OC_MP.ping=Math.max(0,Math.round(performance.now()-m.tc));break;
    case 'erro':ocMpMsg(m.msg||'erro');break;}}
// o mapa precisa ser o mesmo para todos: a sala define a semente
function ocMpSemente(sem){
  if(!sem)return;
  let atual=20261107;try{const q=/[?&]seed=(\d+)/.exec(location.search);if(q)atual=+q[1];}catch(_){}
  if(atual===sem)return;
  OC_MP.sementeDiferente=sem;
  ocMpMsg('Esta sala usa outro mapa. Recarregue com ?seed='+sem+' para ver o mesmo cenário.');}
// ---------------- jogadores remotos ----------------
function ocMpAdd(j){
  if(!j||j.id===OC_MP.id||OC_MP.jog.has(j.id))return;
  const reg={id:j.id,nome:j.nome||'Jogador',modo:j.modo||'policia',u:null,alvo:null,ultimo:0};
  OC_MP.jog.set(j.id,reg);ocMpCorpo(reg);}
// cria o boneco do jogador remoto reaproveitando as unidades do próprio jogo
function ocMpCorpo(reg){
  if(reg.u||typeof mkU!=='function')return;
  try{
    const eu=(window.FPS&&FPS.u)||(window.OC_DIRECT&&OC_DIRECT.u)||units.find(q=>q.team==='P'&&!q.dead);
    const x=eu?eu.x+1.2:60,y=eu?eu.y:60;
    const traf=reg.modo==='traficante';
    const u=mkU(traf?'E':'P',traf?'t':'pm',x,y,{model:Math.floor(Math.random()*3)});
    u._mp=reg.id;u._mpNome=reg.nome;u.order={t:'hold'};u.path=[];u.spawn=0;
    if(traf)u.t3d=true;else u.b3d=true;
    reg.u=u;
  }catch(e){}}
function ocMpRemover(id){
  const r=OC_MP.jog.get(id);if(!r)return;if(r._car){try{const i=cars.indexOf(r._car);if(i>=0)cars.splice(i,1);}catch(_){}r._car=null;}
  if(r.u){try{r.u.dead=9;r.u.hp=0;const i=units.indexOf(r.u);if(i>=0)units.splice(i,1);
    if(r.u._pv&&r.u._pv.parent)r.u._pv.parent.remove(r.u._pv);}catch(_){}}
  OC_MP.jog.delete(id);}
function ocMpLimparRemotos(){for(const id of [...OC_MP.jog.keys()])ocMpRemover(id);}
function ocMpEvento(id,ev){
  const r=OC_MP.jog.get(id);if(!r||!r.u||!ev)return;
  if(ev.k==='tiro'){r.u.flash=.12;r.u.aim=.4;}
  else if(ev.k==='morte'){r.u.dead=1;r.u.hp=0;}
  else if(ev.k==='vivo'){r.u.dead=0;r.u.hp=r.u.max||100;}}
// ---------------- quem eu controlo ----------------
function ocMpEu(){
  const F=window.FPS,D=window.OC_DIRECT;
  if(F&&F.on&&F.u)return F.u;
  if(D&&D.u)return D.u;
  try{if(typeof sel!=='undefined'&&sel&&sel.length&&!sel[0].isCar)return sel[0];}catch(_){}
  return null;}
function ocMpCarroSync(r,e){if(!e.v||!e.v.s){if(r._car){const i=cars.indexOf(r._car);if(i>=0)cars.splice(i,1);r._car=null;}return;}if(!r._car||cars.indexOf(r._car)<0){r._car=mkCar(e.v.s,e.v.x,e.v.y,0);r._car._mpRemote=1;}const c=r._car;c.x=e.v.x;c.y=e.v.y;c._yaw=e.v.g;c.hx=Math.sin(e.v.g);c.hy=Math.cos(e.v.g);c.moving=true;}
function ocMpTick(dt){
  if(!OC_MP.lig||OC_MP.estado!=='sala')return;
  const ag=performance.now();
  // manda o meu estado
  OC_MP._t+=dt*1000;
  if(OC_MP._t>=OC_MP.envioMs){OC_MP._t=0;
    const u=ocMpEu();
    if(u){const c=u.inCar;
      ocMpEnviar({t:'estado',e:{
        x:+u.x.toFixed(3),y:+u.y.toFixed(3),g:+(u._yaw||0).toFixed(3),
        s:+((u._sp||0)).toFixed(2),a:u.aim>0?1:0,c:u.crouch?1:0,d:u.dead?1:0,
        v:c?{x:+c.x.toFixed(2),y:+c.y.toFixed(2),g:+(c._yaw||0).toFixed(2),s:c.sub}:null,
        m:window.GAME_MODE||'policia',h:Math.round(u.hp||0)}});}
    if(ag-OC_MP._pingT>3000){OC_MP._pingT=ag;ocMpEnviar({t:'ping',tc:ag});}}
  // move os outros para onde eles mandaram (suave)
  for(const r of OC_MP.jog.values()){
    if(!r.u){ocMpCorpo(r);continue;}
    const e=r.alvo;if(!e){continue;}try{ocMpCarroSync(r,e);}catch(_){}
    const u=r.u,k=Math.min(1,dt*9);
    u.x+=(e.x-u.x)*k;u.y+=(e.y-u.y)*k;
    let d=(e.g||0)-(u._yaw||0);while(d>Math.PI)d-=2*Math.PI;while(d<-Math.PI)d+=2*Math.PI;
    u._yaw=(u._yaw||0)+d*k;u.fx=Math.sin(u._yaw);u.fy=Math.cos(u._yaw);
    u._sp=e.s||0;u.mv=(e.s||0)>.12;u.aim=e.a?.5:0;u.crouch=e.c?1:0;u._crU=e.c?1:0;
    u.hp=Math.max(1,e.h||100);u.order={t:'hold'};u.path=[];
    if(e.d&&!u.dead)u.dead=1;else if(!e.d&&u.dead)u.dead=0;
    if(ag-(r.ultimo||0)>6000&&!r.sumiu){r.sumiu=1;}   // parado: sem notícias há 6 s
    else if(ag-(r.ultimo||0)<=6000)r.sumiu=0;}}
// ---------------- painel ----------------
function ocMpPainelCria(){
