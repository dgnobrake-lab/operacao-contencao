    if(u._esc){try{u.z=(M3.A.th(u.x,u.y)+(u._alt||0))*PXH3;}catch(_){}continue;}
    if(!u._lajeEsc)continue;
    if(u.dead||u.inCar){u._lajeEsc=null;u._alt=0;u.roof=0;u._queda=0;continue;}
