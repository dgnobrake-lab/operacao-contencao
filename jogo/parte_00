 const R=lxRear(alvo,.5);                          // atrás do veículo, onde fica a carga
 u.ht+=dt;
 const andar=(tx,ty,sp)=>{
  if(!u.path.length||u._hx!==tx||u._hy!==ty){u._hx=tx;u._hy=ty;u.path=astar(u.x,u.y,tx,ty)||[];}
