// comportamento: fica no alto do morro alternando as poses; anda um pouco; com polícia perto levanta as mãos
const TIAO_SHOW=['maos_tras','lado','maos_tras','frente'];
const DONO_DIRS=[[.7,.7],[-.7,.7],[.7,-.7],[-.7,-.7],[1,0],[0,1]];
function tiaoAI(u,dt){u.d9t=(u.d9t||0)+dt;u.dst=(u.dst||0)-dt;if(u.prisao)return;
 if(!u.home)u.home={x:u.x,y:u.y};
 // seguranças em cache; o grupo acompanha o Gerente (sempre cercado)
 if(!u._gt||u.d9t-u._gt>.6){u._gt=u.d9t;u._gs=units.filter(g=>g.g9&&!g.dead);}
 const gs=u._gs||[];
 for(const g of gs){if(g.off&&!g.dead){g.home={x:u.x+g.off.x,y:u.y+g.off.y};if(!g.path.length&&Math.hypot(g.x-g.home.x,g.y-g.home.y)>1.5){const q=rndCell(g.home.x,g.home.y,.8,walk);if(q)g.path=astar(g.x,g.y,q.x,q.y)||[];}}}
 const pol=units.some(p=>p.team==='P'&&!p.dead&&!p.inCar&&Math.hypot(p.x-u.x,p.y-u.y)<7);
 if(pol){u.mv=false;u.run=false;u.walkTo=null;u.yl=0;u.ylG=null;u.d9st='hands_up';return;}
 // esporro: fica de frente para um segurança, gesticulando, e o segurança fica parado olhando para ele
 if(u.yl>0){u.yl-=dt;u.mv=false;const g=u.ylG;
  if(g&&!g.dead){u.fx=g.x-u.x;u.fy=g.y-u.y;g.fx=u.x-g.x;g.fy=u.y-g.y;g.path=[];g.idle=Math.max(g.idle||0,1.2);}
  u.d9st='esporro';if(u.yl<=0){u.ylG=null;u.d9st='maos_tras';u.dst=3+Math.random()*3;}return;}
 if(u.walkTo){const dx=u.walkTo.x-u.x,dy=u.walkTo.y-u.y,d=Math.hypot(dx,dy);
  if(d<.15){u.walkTo=null;u.mv=false;u.dst=4+Math.random()*3;if(u.ylG&&!u.ylG.dead){u.yl=3+Math.random()*3.5;u.d9st='esporro';}}
  else{const sp=.8*dt,nx=u.x+dx/d*sp,ny=u.y+dy/d*sp;
   if(walk(Math.floor(nx),Math.floor(ny))){u.x=nx;u.y=ny;u.fx=dx/d;u.fy=dy/d;u.mv=true;u.ph=(u.ph||0)+dt*5;}else{u.walkTo=null;u.mv=false;u.ylG=null;}}
  return;}
 u.mv=false;
 if(u.dst<=0){
  const gl=gs.filter(g=>!g.dead&&Math.hypot(g.x-u.x,g.y-u.y)<7);
  if(gl.length&&Math.random()<.8){const g=gl[Math.floor(Math.random()*gl.length)],dx=g.x-u.x,dy=g.y-u.y,d=Math.hypot(dx,dy)||1;u.ylG=g;
   if(d>1.6){const tx=g.x-dx/d*1.15,ty=g.y-dy/d*1.15;if(walk(Math.floor(tx),Math.floor(ty)))u.walkTo={x:tx,y:ty};else u.ylG=null;}
   if(u.ylG&&!u.walkTo){u.yl=3+Math.random()*3.5;u.d9st='esporro';u.fx=dx;u.fy=dy;}
   u.dst=u.walkTo?8:1;return;}
  if(Math.random()<.35){for(let i=0;i<8;i++){const a=Math.random()*6.283,r=.8+Math.random()*2.2,tx=u.home.x+Math.cos(a)*r,ty=u.home.y+Math.sin(a)*r;
    if(walk(Math.floor(tx),Math.floor(ty))){u.walkTo={x:tx,y:ty};break;}}}
  u.d9i=((u.d9i||0)+1)%TIAO_SHOW.length;u.d9st=TIAO_SHOW[u.d9i];u.dst=4+Math.random()*3;
  const dd=DONO_DIRS[Math.floor(Math.random()*DONO_DIRS.length)];u.fx=dd[0];u.fy=dd[1];}}

// ===== SISTEMA DE PRISÃO, ESCOLTA E TRANSPORTE ATÉ A DELEGACIA =====
// RENDIDO → ALGEMADO → ESCOLTADO → EMBARCANDO → EM_TRANSPORTE → DESEMBARCANDO → ENTREGUE_NA_DELEGACIA → PRESO
const PRISAO={lista:[]};
const PST={RENDIDO:'RENDIDO',ALGEMADO:'ALGEMADO',ESCOLTADO:'ESCOLTADO',EMBARCANDO:'EMBARCANDO',EM_TRANSPORTE:'EM_TRANSPORTE',
 DESEMBARCANDO:'DESEMBARCANDO',ENTREGUE:'ENTREGUE_NA_DELEGACIA',PRESO:'PRESO'};
const PR_LABEL={RENDIDO:'RENDIDO',ALGEMADO:'ALGEMANDO…',ESCOLTADO:'ESCOLTADO',EMBARCANDO:'EMBARCANDO',EM_TRANSPORTE:'EM TRANSPORTE',DESEMBARCANDO:'DESEMBARCANDO',ENTREGUE_NA_DELEGACIA:'ENTREGUE NA DELEGACIA',PRESO:'PRESO'};
function prGo(P,st){P.st=st;P.t=0;P.u.prSt=st;}
// anda em linha reta até um ponto (sem teletransporte), devolve true ao chegar
function prStep(u,tx,ty,sp,dt,chkWalk){const dx=tx-u.x,dy=ty-u.y,d=Math.hypot(dx,dy);if(d<.04){u.mv=false;return true;}
 const s=Math.min(d,ocAiHuman(ocWoundSp(u,sp))*ocWoundMul(u)*dt),nx=u.x+dx/d*s,ny=u.y+dy/d*s;if(chkWalk&&!walk(nx|0,ny|0)&&!cwalk(nx|0,ny|0)){u.mv=false;return false;}
 u.x=nx;u.y=ny;u.fx=dx/d;u.fy=dy/d;u.mv=true;u.ph=(u.ph||0)+dt*(sp>2.5?12:7.5);return d<=s+.001;}
// segue uma rota (lista de pontos) andando
function prPath(u,sp,dt){if(!u.prRota||!u.prRota.length){u.mv=false;return true;}const p=u.prRota[0];if(prStep(u,p.x,p.y,sp,dt,false))u.prRota.shift();return !u.prRota.length;}
function prRota(u,x,y){u.prRota=astar(u.x,u.y,x,y)||[];u.prRota.push({x,y});}
function prDeleg(){return lots.find(L=>L.isDeleg)||null;}
function prCarRear(c,k){const hx=c.hx||0,hy=c.hy||0,m=Math.hypot(hx,hy)||1;return {x:c.x-hx/m*k,y:c.y-hy/m*k};}
function prNearWalk(x,y){const c=allocCells(1,x|0,y|0,walk)[0];return c?{x:c[0],y:c[1]}:{x,y};}
// escolhe a viatura: PM/Civil livre mais próxima
function prPickCar(u){let b=null,bd=1e9;for(const c of cars){if(!isPol(c)||c.dead||c.prisao||c.sub==='bope'||c.sub==='ranger')continue;if(c.pass.length>=c.cap)continue;const d=Math.hypot(c.x-u.x,c.y-u.y);if(d<bd){bd=d;b=c;}}
 if(!b)for(const c of cars){if(!isPol(c)||c.dead||c.prisao)continue;const d=Math.hypot(c.x-u.x,c.y-u.y);if(d<bd){bd=d;b=c;}}return b;}
// ponto onde a viatura encosta: célula de rua mais perto do preso que tenha rota
function prPickup(c,u){const cells=allocCells(140,u.x|0,u.y|0,cwalk).filter(q=>{const d=Math.hypot(q[0]-u.x,q[1]-u.y);return d>=3&&d<=8;}).sort((a,b)=>Math.abs(Math.hypot(a[0]-u.x,a[1]-u.y)-4.5)-Math.abs(Math.hypot(b[0]-u.x,b[1]-u.y)-4.5));
 for(const q of cells.slice(0,10)){if(cars.some(o=>o!==c&&!o.dead&&Math.hypot(o.x-q[0],o.y-q[1])<1.8))continue;const p=astar(c.x,c.y,q[0],q[1],true);if(p&&p.length){return {x:q[0],y:q[1],path:p};}}return null;}
function prDrive(c,x,y){c.ptl=null;c.follow=null;c.convoyLead=false;c.tv=null;c.parked=false;c.dest={x,y};c.path=astar(c.x,c.y,x,y,true)||[];c.prStuck=0;c.prLast={x:c.x,y:c.y};}
function prDriveTick(c,dt,corta){if(!c.dest)return true;
 // viatura parada atrás da barricada de pneus: na ida para buscar o preso, ela espera ali e o preso desce a pé até ela
 if(corta&&c.pnStop&&time-c.pnStop<.3){c.pnWait=(c.pnWait||0)+dt;if(c.pnWait>2.5){c.dest=null;c.path=[];c.pnWait=0;return true;}}else c.pnWait=0;const d=Math.hypot(c.dest.x-c.x,c.dest.y-c.y);if(d<.6&&!c.path.length){c.dest=null;return true;}
 if(!c.path.length&&d>=.6){replanCar(c);if(!c.path.length&&d<2.2){c.dest=null;return true;}}
 c.prStuck+=dt;if(c.prStuck>2.5){if(Math.hypot(c.x-c.prLast.x,c.y-c.prLast.y)<.3)replanCar(c);c.prStuck=0;c.prLast={x:c.x,y:c.y};}return false;}
// escolta: preso anda na frente pela rota, policial segue a trilha ~0,8 tile atrás; o preso espera se o policial ficar para trás
function prEscolta(P,dt){const u=P.u,cop=P.cop;
 const gap=Math.hypot(cop.x-u.x,cop.y-u.y);let fim=false;
 if(gap<1.25)fim=prPath(u,1.0,dt);else{u.mv=false;}
 P.trail.push({x:u.x,y:u.y});if(P.trail.length>400)P.trail.shift();
 let tgt=null,acc=0;for(let i=P.trail.length-1;i>0;i--){acc+=Math.hypot(P.trail[i].x-P.trail[i-1].x,P.trail[i].y-P.trail[i-1].y);if(acc>=.8){tgt=P.trail[i-1];break;}}
 if(gap>1.15){const k=(gap-.85)/gap;prStep(cop,cop.x+(u.x-cop.x)*k,cop.y+(u.y-cop.y)*k,1.9,dt,false);}
 else if(tgt){const d=Math.hypot(tgt.x-cop.x,tgt.y-cop.y);if(d>.05)prStep(cop,tgt.x,tgt.y,Math.min(1.9,1.0+d*1.2),dt,false);else cop.mv=false;}
 if(!u.mv&&cop.mv===false){cop.fx=u.x-cop.x;cop.fy=u.y-cop.y;}
 return fim&&gap<1.3;}
function prStart(u){const P={u,st:'',t:0,cop:null,car:null,trail:[],alpha:1};u.prisao=P;PRISAO.lista.push(P);prGo(P,PST.RENDIDO);return P;}
