function posePick(u){if(u.hbox&&!u.mv)return 0;if(u.mv)return u.run?2:1;if(u.hrole==='vigia')return 3;return -1;}
function skinFor(u){if(u._sk!==undefined)return u._sk;let r=null;if(SKINS_ON&&u.team==='E'&&BANDIT_SKINS.length){const per=10,k=u.id%per,keep=Math.round(SKIN_SHARE*per);if(k<keep)r=BANDIT_SKINS[(Math.floor(u.id/per)*keep+k)%BANDIT_SKINS.length];}return u._sk=r;}
function poseRowsOK(P){const im=P.mips[0],c=document.createElement('canvas');c.width=im.width;c.height=im.height;const g=c.getContext('2d');g.drawImage(im,0,0);const d=g.getImageData(0,0,c.width,c.height).data,rows=[];for(let r=0;r<4;r++){let any=false;const y0=r*POSE_CH,y1=Math.min(c.height,y0+POSE_CH);for(let y=y0;y<y1&&!any;y++){for(let x=0;x<c.width;x++){if(d[(y*c.width+x)*4+3]>24){any=true;break;}}}rows.push(any);}return rows;}
