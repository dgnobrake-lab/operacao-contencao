// ===================== v75: quem vai na caçamba atira =====================
// O BOPE embarcado ficava só de enfeite: o jogo não deixa quem está em veículo atirar. Na caçamba é diferente —
// eles vão de arma na mão, virados para fora. Aqui, a cada instante, cada um procura um suspeito à vista e dispara,
// usando a mesma função de tiro do resto do jogo (mesmo dano, mesma chance de acerto, mesmo som).
const OC_FOGO={alcance:34,stats:{tiros:0},t:0};
function ocFogoCacamba(dt){
  if(typeof units==='undefined'||typeof shoot!=='function')return;
  OC_FOGO.t-=dt;if(OC_FOGO.t>0)return;OC_FOGO.t=.25;
  const MPU=(window.OC_WORLD&&OC_WORLD.MPU)||4.6, R=OC_FOGO.alcance/MPU;
  for(const u of units){
    if(!u.rgSpec||u.dead||!u.inCar)continue;
    const c=u.inCar;if(!c||c.dead||c.sub!=='ranger'||!c.open)continue;
    if((u.cd=Math.max(0,(u.cd||0)-.25))>0)continue;
    // suspeito mais próximo, dentro do alcance e à vista
    let alvo=null,melhor=R*R;
    for(const e of units){
      if(e.team!=='E'||e.dead||e.inCar||e.surr||e.preso)continue;
      const dx=e.x-u.x,dy=e.y-u.y,d2=dx*dx+dy*dy;
      if(d2>=melhor)continue;
      if(typeof los==='function'){try{if(!los(u.x,u.y,e.x,e.y))continue;}catch(_){}}
      melhor=d2;alvo=e;}
    if(!alvo){u.aim=Math.max(0,(u.aim||0)-.3);continue;}   // sem alvo: baixa a arma e volta a sentar
    // v82: não atira se tem companheiro de farda na linha — era assim que o BOPE da caçamba
    // acabava derrubando PM que estava na frente
    try{const A=M3.A,T=A.THREE,M2=OC_WORLD.MPU;
      const o=new T.Vector3(u.x,A.th(u.x,u.y)+(u._alt||0)+1.35/M2,u.y);
      const ap=new T.Vector3(alvo.x,A.th(alvo.x,alvo.y)+1.1/M2,alvo.y);
      const dv=ap.clone().sub(o),L=dv.length();dv.normalize();
      const ch=ocCharOnSeg(o,dv,L*0.96,e=>e===u);
      if(ch&&ch.e&&ch.e.team===u.team){u.aim=Math.max(0,(u.aim||0)-.3);continue;}
    }catch(_){}
    u.fx=alvo.x-u.x;u.fy=alvo.y-u.y;const n=Math.hypot(u.fx,u.fy)||1;u.fx/=n;u.fy/=n;
    try{shoot(u,alvo);OC_FOGO.stats.tiros++;}catch(_){}}}
window.__ocFogoCacamba=ocFogoCacamba;window.OC_FOGO=OC_FOGO;

// ===================== v75: morreu no confronto? assume o policial mais perto =====================
// Antes, ao ser abatido, o jogo voltava para a visão de comando e o jogador perdia o fio da ação.
// Agora, passada a cena da morte, o controle vai sozinho para o policial vivo mais próximo de onde você caiu,
// no mesmo tipo de visão em que estava (1ª ou 3ª pessoa). Se não sobrar ninguém por perto, volta ao comando.
const OC_MORTE={ligado:true,raioM:260,espera:3.2,_t:0,_quem:null,_modo:null,stats:{trocas:0,semGente:0}};
function ocMorteProx(x,y,evitar){
  if(typeof units==='undefined')return null;
  const MPU=(window.OC_WORLD&&OC_WORLD.MPU)||4.6, R=OC_MORTE.raioM/MPU;
  let melhor=null,md=R*R;
  for(const u of units){
    if(u===evitar||u.dead||u.inCar)continue;
    if(u.team!=='P')continue;
    if(u.wState==='INCAPACITATED')continue;
    const dx=u.x-x,dy=u.y-y,d2=dx*dx+dy*dy;
    if(d2<md){md=d2;melhor=u;}}
  return melhor;}
function ocMorteTick(dt){
  if(!OC_MORTE.ligado)return;
  const F=window.FPS,D=window.OC_DIRECT;
  const emFps=!!(F&&F.on&&F.u), emTerceira=!!(D&&D.u);
  const eu=emFps?F.u:(emTerceira?D.u:null);
  if(eu&&(eu.dead||eu.wState==='INCAPACITATED')){
    if(!OC_MORTE._quem){OC_MORTE._quem=eu;OC_MORTE._modo=emFps?'fps':'terceira';
      OC_MORTE._x=eu.x;OC_MORTE._y=eu.y;OC_MORTE._t=OC_MORTE.espera;}
    return;}
  if(!OC_MORTE._quem)return;
  OC_MORTE._t-=dt;if(OC_MORTE._t>0)return;
  const caiu=OC_MORTE._quem,modo=OC_MORTE._modo;
  OC_MORTE._quem=null;OC_MORTE._modo=null;
  const novo=ocMorteProx(OC_MORTE._x,OC_MORTE._y,caiu);
  if(!novo){OC_MORTE.stats.semGente++;if(typeof toast==='function')toast('Sem policial por perto para assumir');return;}
  try{
    const G=window.__game;
    if(G&&G.setSel)G.setSel([novo]);
    if(modo==='fps'&&G&&G.fpsEnter){if(window.FPS&&FPS.on)G.fpsExit();G.fpsEnter();}
    else if(typeof gtaStart==='function'){gtaStart(novo);}
    else if(G&&G.fpsEnter){G.fpsEnter();}
    OC_MORTE.stats.trocas++;
    const MPU=(window.OC_WORLD&&OC_WORLD.MPU)||4.6;
    const d=Math.round(Math.hypot(novo.x-OC_MORTE._x,novo.y-OC_MORTE._y)*MPU);
    if(typeof toast==='function')toast('Assumindo o policial mais próximo · '+d+' m');
  }catch(_){}}
