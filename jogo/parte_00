function busDoBoard(c,stop,dt){
  // Embarca passageiros na fila desta parada que são da mesma linha
  if(!stop)return;
  let changed=false;
  for(let i=stop.queue.length-1;i>=0;i--){
    const u=stop.queue[i];
    if(!u||u.dead||u.inCar)continue;
    if(u.busLine!==c.jcol)continue;
