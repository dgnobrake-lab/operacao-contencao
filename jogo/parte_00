function spawnBusPassengers(){
  // 8 passageiros por linha esperando nas paradas
  for(let ln=0;ln<2;ln++){
    const line=BUS_LINES[ln];
    if(!line||line.stops.length<1)continue;
    for(let i=0;i<8;i++){
