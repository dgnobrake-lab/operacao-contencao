   if(!P.abord){const cand=[[-.55,-.55],[-.75,0],[0,-.75],[.55,-.55],[-.55,.55],[.75,0],[0,.75],[.55,.55]];for(const q of cand){const x=u.x+q[0],y=u.y+q[1];if(walk(x|0,y|0)){P.abord={x,y};break;}}if(!P.abord)P.abord={x:u.x+.6,y:u.y};}
   const bx=P.abord.x,by=P.abord.y;
   P.rt=(P.rt||0)+dt;if(!c2.prRota||!c2.prRota.length||P.rt>1.5){P.rt=0;prRota(c2,bx,by);}
   prPath(c2,1.6,dt);u.fx=c2.x-u.x;u.fy=c2.y-u.y;
   if(!P.car){P.car=prPickCar(u);if(P.car){P.car.prisao=P;const pk=prPickup(P.car,u);if(pk){P.pick={x:pk.x,y:pk.y};prDrive(P.car,pk.x,pk.y);}else P.pick=null;}}
   if(P.car&&P.car.dest)prDriveTick(P.car,dt,true);
   if(Math.hypot(c2.x-bx,c2.y-by)<.25||(Math.hypot(c2.x-u.x,c2.y-u.y)<1.1&&P.t>8)){c2.prRota=[];c2.mv=false;prGo(P,PST.ALGEMADO);}
