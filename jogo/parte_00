}
// porta da delegacia: fachada leste do lote (ver bloco da 74ª DP); custódia = calçada em frente à entrada
function prCustodia(D){const ex=D.x+D.w+.5,ey=D.y+D.h-.5;return walk(ex|0,ey|0)?{x:ex,y:ey}:prNearWalk(ex,ey);}
function prParkDeleg(D,c){const ex=D.x+D.w+1,ey=D.y+D.h/2;const cells=allocCells(16,ex|0,ey|0,cwalk).sort((a,b)=>Math.hypot(a[0]-ex,a[1]-ey)-Math.hypot(b[0]-ex,b[1]-ey));
