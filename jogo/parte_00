// ===== SISTEMA DE MARCAS DE BALA =====
// BULLET_IMG: imagem base64 do impacto realista (fundo branco → multiply blend)
// WALL_HOLES: Array de {x,y,ang,mat,s} — marcas permanentes no cenário
// Car holes: c.holes[] = [{u,v,ang,s,mat}]

const WALL_HOLES=[];  // marcas no cenário/paredes
const MAX_HOLES=300;

// Materiais e variações
const HOLE_MAT={
  concrete:{s:[.55,.7,.85],a:[.72,.8,.88]},
  brick:   {s:[.6,.8,1.0], a:[.75,.85,.9]},
  metal:   {s:[.5,.65,.8], a:[.65,.78,.88]},
  wood:    {s:[.65,.85,1.1],a:[.7,.82,.9]},
  car:     {s:[.4,.55,.7], a:[.7,.82,.9]},
  glass:   {s:[.3,.45,.6], a:[.5,.65,.8]}
};

// Detecta material pelo tipo de tile/objeto atingido
function holeMat(t,iscar){
  if(iscar)return'car';
  if(t===1)return Math.random()<.6?'brick':'concrete';
  if(t===0||t===7)return'concrete';
  if(t===4)return'wood';
  return'concrete';
}

// Adiciona marca de bala no cenário
function addWallHole(wx,wy,t){
  if(WALL_HOLES.length>=MAX_HOLES)WALL_HOLES.shift();
  const mat=holeMat(t,false);
  const cfg=HOLE_MAT[mat];
  WALL_HOLES.push({
    x:wx,y:wy,
    ang:Math.random()*Math.PI*2,
    s:cfg.s[Math.floor(Math.random()*cfg.s.length)],
    a:cfg.a[Math.floor(Math.random()*cfg.a.length)],
    mat,
    vi:Math.floor(Math.random()*8)  // variação do sprite (0-7)
  });
}

// Adiciona marca em carro (u,v em espaço local do carro)
function addCarHole(car,bx,by){
  car.holes=car.holes||[];
  const blind=(car.sub==='bope');   // Caveirão é blindado: fica a marca e o risco, sem furo
  if(car.holes.length>=(car.sub==='jeep'?60:blind?40:24))car.holes.shift();
  const hh=Math.hypot(car.hx||0,car.hy||0);
  if(hh>.01){car.lhx=car.hx/hh;car.lhy=car.hy/hh;}
  const fx=car.lhx===undefined?1:car.lhx,fy=car.lhy===undefined?0:car.lhy;
  const dx=bx-car.x,dy=by-car.y;
  const u=dx*fx+dy*fy,v=-dx*fy+dy*fx;   // local ao carro (frente/lado)
  const cfg=HOLE_MAT.car;
  car.holes.push({
    u:Math.max(-.4,Math.min(.4,u)),
    v:Math.max(-.22,Math.min(.22,v)),
    z:13+Math.random()*13,
    ang:Math.random()*Math.PI*2,
    s:cfg.s[Math.floor(Math.random()*cfg.s.length)]*(blind?.8:1.3),
    a:blind?.5:Math.min(1,cfg.a[Math.floor(Math.random()*cfg.a.length)]+.1),
    vi:Math.floor(Math.random()*8),
    ric:blind?1:0, rl:blind?rr(2.5,6):0, ra:blind?rr(0,Math.PI*2):0
  });
}

// Desenha uma marca de bala em sx,sy com ângulo ang, escala s, opacidade a
// marca de ricochete em blindado: lasca a pintura e deixa o risco, sem perfurar
function drawScratch(ctx,sx,sy,ang,len,a){
  ctx.save();ctx.translate(sx,sy);ctx.rotate(ang);ctx.scale(1,.62);
  ctx.globalAlpha=a*.85;ctx.strokeStyle='#d8d8dc';ctx.lineWidth=1.1;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-len/2,0);ctx.lineTo(len/2,0);ctx.stroke();
  ctx.globalAlpha=a*.55;ctx.strokeStyle='#4a4a50';ctx.lineWidth=.6;
  ctx.beginPath();ctx.moveTo(-len/2,.8);ctx.lineTo(len/2,.8);ctx.stroke();
  ctx.globalAlpha=a;ctx.fillStyle='#2a2a2e';ctx.beginPath();ctx.ellipse(-len/2,0,1.1,1.1,0,0,7);ctx.fill();
  ctx.globalAlpha=1;ctx.restore();
}
function drawHoleAt(ctx,sx,sy,ang,s,a,vi){
  if(!BHOLE_IMG||!BHOLE_IMG.complete||!BHOLE_IMG.naturalWidth)return;
  const W=BHOLE_IMG.naturalWidth/4,H=BHOLE_IMG.naturalHeight/2;
  const sx0=(vi%4)*W,sy0=Math.floor(vi/4)*H;
  const dw=8*s,dh=8*s*.62;
  ctx.save();
  ctx.globalAlpha=a;
  ctx.globalCompositeOperation='multiply';
  ctx.translate(sx,sy);
  ctx.rotate(ang);
  ctx.drawImage(BHOLE_IMG,sx0,sy0,W,H,-dw/2,-dh/2,dw,dh);
  ctx.globalCompositeOperation='source-over';
  ctx.globalAlpha=1;
  ctx.restore();
}

// Desenha marcas nas paredes do cenário (chamado no loop de props/ground)
function drawWallHoles(ctx,vx0,vx1,vy0,vy1){
  for(const h of WALL_HOLES){
    const sx=(h.x-h.y)*S,sy=(h.x+h.y)*16-hillLift(h.x,h.y);
    if(sx<vx0-40||sx>vx1+40||sy<vy0-20||sy>vy1+40)continue;
    drawHoleAt(ctx,sx,sy,h.ang,h.s,h.a,h.vi);
  }
}

// Desenha marcas no carro (chamado no drawCar, após o sprite principal)
function drawCarHoles(ctx,car){
  if(!car.holes||!car.holes.length)return;
  const hh=Math.hypot(car.hx||0,car.hy||0);
  if(hh>.01){car.lhx=car.hx/hh;car.lhy=car.hy/hh;}
  const fx=car.lhx===undefined?1:car.lhx,fy=car.lhy===undefined?0:car.lhy;
  const csx=(car.x-car.y)*S,csy=(car.x+car.y)*16;
  const bob=car.moving?Math.sin(car.dist*16)*.6:0;
  for(const h of car.holes){
    const lx=h.u*fx-h.v*fy, ly=h.u*fy+h.v*fx;
    const hx2=csx+(lx-ly)*S,hy2=csy+(lx+ly)*16+2+bob-h.z;
    if(h.ric)drawScratch(ctx,hx2,hy2,h.ra,h.rl,h.a);
    else drawHoleAt(ctx,hx2,hy2,h.ang,h.s,h.a,h.vi);
  }
}

