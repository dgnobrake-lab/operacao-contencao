const TOCAVEL='button,[onclick],[role=button],a[href],input,select,.pd,.chip,#ocDTzone,#ocDTidle,[id$=Btn],[id$=btn],[id*=Fab],[id*=fab],#mm,#ocOnPainel,#ocNetDiag';
