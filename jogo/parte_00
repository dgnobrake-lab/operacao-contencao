setInterval(()=>{try{ocBopeBotao();}catch(_){}},500);
window.__ocBopeBotao=ocBopeBotao;

// ===================== v74: POLÍCIA CIVIL — modelos próprios (delegado, playboy, delegado F. Curi) =====================
// Os policiais civis (sub 'pc') usavam o mesmo boneco da PM. Agora revezam entre os três modelos do usuário
// e continuam andando nos carros da Civil (pcv/pc), como já faziam.
