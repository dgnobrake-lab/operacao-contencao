   if(P.t>5){P.cuff=1;prGo(P,PST.ESCOLTADO);const tg=P.pick?prNearWalk(P.pick.x,P.pick.y):prNearWalk(u.x,u.y);prRota(u,tg.x,tg.y);P.trail=[{x:cop.x,y:cop.y},{x:u.x,y:u.y}];
