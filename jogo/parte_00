// ===================== v74: BOPE SENTADO NA CAÇAMBA DA RANGER (3D) =====================
// Antes, quem embarcava sumia do 3D (só aparecia no tático 2D). Agora o pessoal da caçamba continua visível,
// sentado, cada um com uma animação diferente (mocap da Mixamo convertido para o formato do jogo).
// A caçamba é MEDIDA no próprio modelo 3D: o comprimento é fatiado, a parte baixa de trás é a caçamba e o piso
// fica a 45 cm abaixo da borda dela. Assim não depende de números chutados.
const OC_BED={
  luz:0.34,   // brilho extra de quem vai na caçamba: na sombra do carro eles sumiam

  poses:['Sentado 1','Sentado 2','Sentado 4','Sentado Atoa','Sentado Gesticulando','Sentado Balancando',
         'Sentado Tonto','Sentado De Boa','Sentado De Boa 2','Sentado Canto Esquerdo','Sentado Jogadao',
         'Sentado Tudo Bem','Sentado Chama Os Outros'],
  stats:{sentados:0,medidas:0,semClipe:0},
  geo:{},        // medidas por template de veículo
  inverter:true, // o modelo da Ranger fica virado ao contrário do eixo do veículo no jogo (acertado na tela)
  // como nas fotos reais: na borda só cabem TRÊS com as pernas para fora (dois na traseira e um na lateral);
  // os outros vão EM PÉ, atrás deles, segurando na gaiola.
  // [lado (fração da meia-largura da caçamba), avanço (0=cabine, 1=traseira), giro, 'sentado' ou 'pe']
  // como na foto: os três sentados ficam LADO A LADO na borda traseira, virados para trás, pernas para fora;
  // os demais vão em pé, atrás deles, segurando na gaiola.
  lug:[[-.62,.95,Math.PI,'sentado'],[0,.95,Math.PI,'sentado'],[.62,.95,Math.PI,'sentado'],
       [-.38,.40,Math.PI,'pe'],[.38,.40,Math.PI,'pe']],
  alturaBorda:true,   // quem senta na borda fica com as pernas para fora
};
// mede a caçamba no modelo do veículo (uma vez por template)
function ocBedGeom(c,nm){
  const g=OC_BED.geo;if(g[nm])return g[nm];
  const A=window.__m3,T=A&&A.THREE,m=c._m3m;if(!T||!m)return null;
  // mede com a viatura sem rotação e SÓ restaura o giro depois de varrer os vértices:
  // restaurar antes fazia a varredura ler coordenadas giradas e a largura saía maior que o próprio carro.
  const ry=m.rotation.y;m.rotation.y=0;m.updateMatrixWorld(true);
  const bb=new T.Box3().setFromObject(m);
  const mn=bb.min.clone(),sz=bb.getSize(new T.Vector3());
  const eixoZ=sz.z>=sz.x, comp=eixoZ?sz.z:sz.x, N=16;
  const alt=new Array(N).fill(-1e9), ys=[], xs=[];
  const v=new T.Vector3();
  m.traverse(o=>{if(!o.isMesh||!o.geometry||!o.geometry.attributes.position)return;
    const pa=o.geometry.attributes.position,ar=pa.data?pa.data.array:pa.array,st=pa.data?pa.data.stride:pa.itemSize,of=pa.data?pa.offset:0;
    const kk=pa.normalized?(ar instanceof Int16Array?1/32767:ar instanceof Uint16Array?1/65535:ar instanceof Int8Array?1/127:ar instanceof Uint8Array?1/255:1):1;
    const passo=Math.max(1,Math.floor(pa.count/6000));
    for(let i=0;i<pa.count;i+=passo){v.set(ar[i*st+of]*kk,ar[i*st+of+1]*kk,ar[i*st+of+2]*kk).applyMatrix4(o.matrixWorld);
      const t=eixoZ?(v.z-mn.z)/sz.z:(v.x-mn.x)/sz.x, k=Math.min(N-1,Math.max(0,Math.floor(t*N)));
      if(v.y>alt[k])alt[k]=v.y;ys.push([t,v.y]);xs.push([t,v.y,eixoZ?v.x:v.z]);}});
  m.rotation.y=ry;m.updateMatrixWorld(true);   // devolve o giro da viatura
  const topo=Math.max(...alt), lim=mn.y+(topo-mn.y)*.62;
  // caçamba = sequência de fatias baixas numa das pontas
  let ini=-1,fim=-1;
  for(let k=N-1;k>=0;k--){if(alt[k]<lim){if(fim<0)fim=k;ini=k;}else if(fim>=0)break;}
  let frente=false;
  if(fim<0){for(let k=0;k<N;k++){if(alt[k]<lim){if(ini<0)ini=k;fim=k;}else if(ini>=0)break;}frente=true;}
  if(ini<0){ini=Math.floor(N*.7);fim=N-1;}
  const t0=ini/N, t1=(fim+1)/N;
  // piso da caçamba: a borda (ponto mais alto da parte baixa de trás) menos a altura da parede lateral (~45 cm).
  // Medir o pico de vértices pegava o chassi e punha o pessoal baixo demais.
  let borda=-1e9;for(let k=ini;k<=fim;k++)if(alt[k]>borda)borda=alt[k];
  const MPU=(window.OC_WORLD&&OC_WORLD.MPU)||4.6;
  const piso=Math.max(mn.y+(topo-mn.y)*.18, borda-0.45/MPU);
  // largura da caçamba: só os vértices que estão nela e na altura das paredes (fora espelhos, pneus e para-choque)
  const eixoX=eixoZ?mn.x+sz.x/2:mn.z+sz.z/2;   // meio do veículo no eixo da largura
  const lados=[];const yA=piso+0.02/MPU, yB=borda-0.02/MPU;
  for(const [t,y,x] of xs){if(t<t0||t>t1||y<yA||y>yB)continue;lados.push(Math.abs(x-eixoX));}
  lados.sort((a,b)=>a-b);
  const meiaL=lados.length?lados[Math.floor(lados.length*.97)]:(eixoZ?sz.x/2:sz.z/2);
  const r={eixoZ,t0,t1,frente,piso:piso-mn.y,bordaM:+((borda-mn.y)*MPU).toFixed(2),pisoM:+((piso-mn.y)*MPU).toFixed(2),
           larguraCacambaM:+(meiaL*2*MPU).toFixed(2),meiaL,
           minY:mn.y,A:sz.x/2,B:sz.z/2,H:sz.y,comp};
  OC_BED.stats.medidas++;return g[nm]=r;}
// pose fixa por pessoa, sem repetir na mesma viatura
function ocBedPose(u,c){if(u._bedPose)return u._bedPose;
  const AN=window.ANIM||null;const P=OC_BED.poses.filter(n=>AN&&AN[n]);const L=P.length?P:OC_BED.poses;
  const usadas=(c.pass||[]).filter(q=>q!==u&&q._bedPose).map(q=>q._bedPose);
  const livres=L.filter(n=>!usadas.includes(n));const E=livres.length?livres:L;
  u._bedPose=E[Math.floor(Math.random()*E.length)];return u._bedPose;}
// a formação também muda de partida para partida: os lugares são embaralhados uma vez
function ocBedOrdem(){
  if(OC_BED._ordem)return OC_BED._ordem;
  const n=OC_BED.lug.length, idx=[];
  for(let i=0;i<n;i++)idx.push(i);
  // embaralha mantendo os três sentados nos três primeiros e os de pé atrás
  const sent=idx.filter(i=>OC_BED.lug[i][3]!=='pe'), pe=idx.filter(i=>OC_BED.lug[i][3]==='pe');
  const mix=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;};
  return OC_BED._ordem=mix(sent).concat(mix(pe));}
// devolve true quando tratou a pessoa (sentada na caçamba)
// acende um pouco o personagem que está na caçamba (material é por boneco, não mexe nos outros)
function ocBedLuz(u){
  if(!u||u._bedLuz||!u._pv)return;u._bedLuz=1;
  try{u._pv.traverse(o=>{if(!o.isMesh||!o.material)return;
    const ms=Array.isArray(o.material)?o.material:[o.material];
    for(const m of ms){if(!m||!m.emissive)continue;
      if(!m.userData)m.userData={};
      if(m.userData.ocBedLuz)continue;m.userData.ocBedLuz=1;
      if(m.map&&!m.emissiveMap)m.emissiveMap=m.map;
      const k=OC_BED.luz;m.emissive.setRGB(k,k,k);m.needsUpdate=true;}});}catch(_){}}
function ocBedRide(u,pv,r,dt){
  const c=u.inCar;if(!c||c.dead||c.sub!=='ranger'||!c.open||!u.rgSpec||u.dead)return false;
  const A=window.__m3;if(!A||!c._m3m||!r)return false;
  const G=ocBedGeom(c,'ranger');if(!G)return false;
  ocBedLuz(u);
  const ord=ocBedOrdem();const lug=OC_BED.lug[ord[(u.bedSlot|0)%ord.length]];
  // avanço dentro da caçamba, em unidades, medido do centro do veículo
  const t=G.t0+(G.t1-G.t0)*lug[1], meio=(t-.5)*(G.eixoZ?G.B*2:G.A*2);
  const lado=lug[0]*(G.meiaL||(G.eixoZ?G.A:G.B));
  const sinal=(G.frente?-1:1)*(OC_BED.inverter?-1:1), ca=Math.cos(c._yaw||0), sa=Math.sin(c._yaw||0);
  const lx=lado, lz=meio*sinal;
  const wx=c.x+lx*ca+lz*sa, wz=c.y-lx*sa+lz*ca;
  const MPU2=(window.OC_WORLD&&OC_WORLD.MPU)||4.6;
  const emPe=lug[3]==='pe';
  const naBorda=!emPe&&OC_BED.alturaBorda;        // sentado na borda: pernas para fora
  const base=(c._m3m.position.y)+G.piso+(naBorda?Math.max(0,(G.bordaM-G.pisoM-0.42))/MPU2:0);
  const _F=window.FPS;pv.visible=!(_F&&_F.on&&u===_F.u);
  pv.position.set(wx,base,wz);pv.rotation.y=(c._yaw||0)+lug[2]+(G.frente?Math.PI:0);
  {const ms=(_F&&_F.on)?1:OC_WORLD.tac.char;if(pv.scale.x!==ms)pv.scale.setScalar(ms);}
  const passo=Math.min(.25,dt||.016),vida=Math.max(0,u.hp/(u.max||100));
  const fogo=Math.max(0,u.flash||0), mirando=fogo>0||(u.aim||0)>0;
  if(emPe){   // de pé na caçamba, atrás dos que estão sentados
    try{r.update(passo,{clip:null,spd:0,run:false,aim:true,crouch:false,hurt:0,flash:fogo,
        hp:vida,dead:0,crawl:false,civ:false,carry:false});}catch(_){return false;}
    if(!u._bedCount){u._bedCount=1;OC_BED.stats.sentados++;}
    return true;}
  const nome=ocBedPose(u,c);
  const AN2=window.ANIM||null;if(!(AN2&&AN2[nome])){OC_BED.stats.semClipe++;return false;}
  // sentado: quando atira, larga a pose de descanso e assume a de tiro (com o clarão)
  try{r.update(passo,mirando
      ?{clip:null,spd:0,run:false,aim:true,crouch:true,hurt:0,flash:fogo,hp:vida,dead:0,crawl:false,civ:false,carry:false}
      :{clip:nome,spd:0,run:false,aim:false,crouch:false,hurt:0,flash:0,hp:vida,dead:0,crawl:false,civ:false,carry:false}
    );}catch(_){return false;}
  if(!u._bedCount){u._bedCount=1;OC_BED.stats.sentados++;}
  return true;}
window.__ocBed=ocBedRide;window.OC_BED=OC_BED;

// ===================== v74: BOPE — 4 soldados com modelo próprio, sempre na caçamba da Ranger =====================
// O jogo não tinha policial do BOPE: a tropa era toda PM (sub 'pm') e PC (sub 'pc'); 'bope' era só a viatura Caveira.
// Aqui nascem os 4 soldados do BOPE (capitão, careca, sniper fantasma e o modelo de sniper que já existia),
// um modelo para cada, sem repetir. Em QUALQUER modo (tático, 1ª e 3ª pessoa) eles andam na caçamba da Ranger:
// quem é do BOPE tem rgSpec, e com isso o jogo só o deixa embarcar pela caçamba — o volante e a cabine ficam
// para a PM, que ainda leva mais 3 além do motorista.
const OC_BOPE={modelos:['bopecap','bopecar','bopesnp'],n:4,stats:{marcados:0,porModelo:{},aberturas:0,volante:0},feito:false};
function ocBopeRangers(){
  // a caçamba da Ranger fica aberta: é por ela que o BOPE embarca, em todos os modos
  if(typeof cars==='undefined'||typeof rangerSetOpen!=='function')return;
  for(const c of cars){if(c.sub!=='ranger'||c.dead||c.open)continue;
    try{rangerSetOpen(c,true);OC_BOPE.stats.aberturas++;}catch(_){}}}
window.__ocAbrirCacamba=function(c){
  try{if(c&&c.sub==='ranger'&&!c.dead&&!c.open&&typeof rangerSetOpen==='function'){rangerSetOpen(c,true);OC_BOPE.stats.aberturas++;}}catch(_){}
  return c&&c.open;};
// o volante é da PM: se um BOPE acabar dirigindo, devolve o lugar e manda para a caçamba
function ocBopeVolante(){
  try{const d=(typeof driving!=='undefined')?driving:null;if(!d||!d.car||!d.driver)return;
    if(d.car.sub==='ranger'&&d.driver.rgSpec)OC_BOPE.stats.volante++;}catch(_){}}
function ocBopeMontar(){
  if(OC_BOPE.feito){ocBopeRangers();return;}
  const A=(typeof M3!=='undefined'&&M3.A)?M3.A:null;
  const rg=(typeof cars!=='undefined')?cars.find(c=>c.sub==='ranger'&&!c.dead):null;
  let cand=units.filter(u=>u.team==='P'&&!u.dead&&u.sub==='pm'&&!u.boss&&!u.t3d&&!u.asset&&!u.inCar);
  if(cand.length<OC_BOPE.n)return;
  if(rg)cand.sort((a,b)=>Math.hypot(a.x-rg.x,a.y-rg.y)-Math.hypot(b.x-rg.x,b.y-rg.y));   // os mais perto da Ranger viram BOPE
  const ok=OC_BOPE.modelos.filter(k=>!(A&&A.extraErrors&&A.extraErrors[k]));
  for(let i=0;i<OC_BOPE.n&&i<cand.length;i++){const u=cand[i];
    u.sub='bope';u.rgSpec=1;u._bope=1;
    if(i<ok.length){u.asset=ok[i];OC_BOPE.stats.porModelo[ok[i]]=1;}
    else{u.asset=null;u.mdl=(A&&A.pol&&A.sniper)?A.pol.length-1:3;OC_BOPE.stats.porModelo.sniper=1;}
    if(rg)u.lastCar=rg;   // a viatura deles é a Ranger
    if(u._r||u._pv){try{if(u._pv&&u._pv.parent)u._pv.parent.remove(u._pv);}catch(_){}u._r=null;u._pv=null;}   // refaz o boneco com o modelo novo
    OC_BOPE.stats.marcados++;}
  OC_BOPE.feito=OC_BOPE.stats.marcados>0;
  ocBopeRangers();}
try{ocBopeMontar();}catch(_){}
setTimeout(()=>{try{ocBopeMontar();}catch(_){}},4000);
setInterval(()=>{try{ocBopeRangers();ocBopeVolante();}catch(_){}},2500);   // vale em todos os modos
window.OC_BOPE=OC_BOPE;window.__ocBopeMontar=ocBopeMontar;
// ---- botão EMBARCAR BOPE / DESEMBARCAR BOPE (o nome muda conforme a situação) ----
function ocBopeRanger(){try{return cars.find(c=>c.sub==='ranger'&&!c.dead)||null;}catch(_){return null;}}
function ocBopeNaCacamba(rg){if(!rg)return [];return (rg.pass||[]).filter(q=>q.rgSpec&&!q.dead);}
function ocBopeAPe(){try{return units.filter(u=>u.rgSpec&&!u.dead&&!u.inCar);}catch(_){return [];}}
function ocBopeBotao(){
  const b=document.getElementById('bMala');if(!b)return;
  const rg=ocBopeRanger(),dentro=ocBopeNaCacamba(rg).length,fora=ocBopeAPe().length;
