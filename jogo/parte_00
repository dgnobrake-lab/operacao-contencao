  a.style.cssText='position:fixed;left:50%;top:92px;transform:translateX(-50%);z-index:41;display:none;'+
    'background:#0e151bEE;border:1px solid #2b3a46;border-radius:8px;padding:6px 12px;'+
    'font:600 12px "Segoe UI",Arial,sans-serif;color:#9fe8b0';
  document.body.appendChild(a);
  const ind=document.createElement('div');ind.id='ocMpLuz';
  ind.style.cssText='position:fixed;right:10px;top:58px;z-index:41;display:none;align-items:center;gap:6px;'+
    'background:#0e151bCC;border:1px solid #2b3a46;border-radius:999px;padding:4px 10px;'+
    'font:600 11px "Segoe UI",Arial,sans-serif;color:#cfe;cursor:pointer';
  ind.onclick=()=>ocMpAbrir();
  document.body.appendChild(ind);}
function ocMpAbrir(){ocMpPainelCria();const d=document.getElementById('ocMpPainel');
  d.style.display=d.style.display==='none'?'block':'none';ocMpPainel();}
function ocMpPainel(){
  ocMpPainelCria();
  const d=document.getElementById('ocMpPainel'),luz=document.getElementById('ocMpLuz');
