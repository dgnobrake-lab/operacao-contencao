// ---------- modelo ----------
function ocFutCarrega(){
  const S=OC_FUT,A=(typeof M3!=='undefined')?M3.A:null;
  if(S.tpl||S.carregando||!A||!A.parseGltf)return;
  const el=document.getElementById('oc-bola80');if(!el)return;S.carregando=true;
  (async()=>{try{
    const D=JSON.parse(el.textContent),T=A.THREE;
    const raw=Uint8Array.from(atob(D.bola),c=>c.charCodeAt(0));
    const bytes=await ocGunzip(raw);
    const g=await A.parseGltf(bytes);const root=g.scene;root.updateMatrixWorld(true);
    root.traverse(o=>{if(o.isMesh){o.castShadow=false;o.receiveShadow=false;o.raycast=()=>{};
      if(o.material){o.material.metalness=0;o.material.roughness=.85;}}});
    const bb=new T.Box3().setFromObject(root),sz=bb.getSize(new T.Vector3()),c=bb.getCenter(new T.Vector3());
    const d=Math.max(sz.x,sz.y,sz.z)||1;
    const wrap=new T.Group();root.position.set(-c.x,-c.y,-c.z);wrap.add(root);   // centro no centro da bola
    S.tpl={obj:wrap,d};
