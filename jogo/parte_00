// ===================== v86: VOZ ENTRE OS JOGADORES (microfone) =====================
// A voz vai direto de um aparelho para o outro (WebRTC, gratuito). O servidor da partida só repassa a
// "apresentação" das duas pontas (mensagens 'sig'). Botão 🎤 ao lado da luz da partida online:
//   toque 1: liga o microfone (o navegador pede permissão na primeira vez) · toque 2: muda (silencia)
// Quem não ligou o microfone também escuta: a conexão é aberta por quem ligou.
(function(){
'use strict';
const V={on:false,mudo:false,stream:null,pcs:{},audios:{},estado:'desligado',falando:false,
  ICE:[{urls:['stun:stun.l.google.com:19302','stun:stun1.l.google.com:19302']},{urls:'stun:stun.cloudflare.com:3478'}]};
window.OC_VOZ=V;
const sala=()=>window.OC_ON&&OC_ON.sala&&OC_ON.estado==='sala'?OC_ON.sala:null;
const eu=()=>{const s=sala();return s?s.sessionId:null;};
function outros(){const s=sala();if(!s||!s.state||!s.state.jogadores)return [];const r=[];s.state.jogadores.forEach((j,id)=>{if(id!==s.sessionId)r.push(id);});return r;}
function sig(para,o){const s=sala();if(!s)return;try{s.send('sig',Object.assign({para},o));}catch(_){}}
function botao(){let b=document.getElementById('ocVozBtn');if(b)return b;
  b=document.createElement('div');b.id='ocVozBtn';
  b.style.cssText='position:fixed;z-index:44;display:none;align-items:center;justify-content:center;width:40px;height:40px;'+
    'border-radius:50%;background:#0e151bE6;border:2px solid #2b3a46;font:18px system-ui;cursor:pointer;user-select:none;'+
    '-webkit-tap-highlight-color:transparent;touch-action:manipulation';
  b.title='Microfone da partida';b.onclick=e=>{e.stopPropagation();alterna();};document.body.appendChild(b);return b;}
function pinta(){const b=botao();const s=sala();b.style.display=s?'flex':'none';if(!s)return;
  const cor=!V.on?'#2b3a46':V.mudo?'#ff6b5b':V.estado==='conectado'?'#5ee08a':'#e8c46a';
  b.style.borderColor=cor;b.textContent=!V.on?'🎤':V.mudo?'🔇':'🎙️';
  b.style.boxShadow=V.falando&&V.on&&!V.mudo?'0 0 0 4px #5ee08a55':'none';
  b.title=!V.on?'Ligar microfone':V.mudo?'Microfone mudo — toque para falar':'Microfone ligado ('+V.estado+') — toque para mudar';}
async function alterna(){
  if(!V.on){try{V.stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});}
    catch(e){aviso('Microfone não liberado: '+(e&&e.name==='NotAllowedError'?'permissão negada':'sem microfone'));return;}
    V.on=true;V.mudo=false;medidor();desbloqueia();for(const id of outros())conecta(id,true);aviso('Microfone ligado');}
  else{V.mudo=!V.mudo;if(V.stream)for(const t of V.stream.getAudioTracks())t.enabled=!V.mudo;aviso(V.mudo?'Microfone mudo':'Microfone ligado');}
  pinta();}
function aviso(t){try{if(typeof ocMpMsg==='function')ocMpMsg(t);}catch(_){}}
function pc(id){if(V.pcs[id])return V.pcs[id];const p=new RTCPeerConnection({iceServers:V.ICE});V.pcs[id]=p;
  p.onicecandidate=e=>{if(e.candidate)sig(id,{tipo:'ice',c:e.candidate.toJSON?e.candidate.toJSON():e.candidate});};
  p.ontrack=e=>{let a=V.audios[id];if(!a){a=document.createElement('audio');a.autoplay=true;a.playsInline=true;a.style.display='none';document.body.appendChild(a);V.audios[id]=a;}
    a.srcObject=e.streams[0]||new MediaStream([e.track]);a.play().catch(()=>{aviso('Toque na tela para ouvir o outro jogador');V._bloq=true;});};
  p.onconnectionstatechange=()=>{const s=p.connectionState;V.estado=s==='connected'?'conectado':s==='failed'?'falhou':s==='disconnected'?'caiu':'conectando';
    if(s==='failed'){aviso('Voz: a rede de um dos aparelhos bloqueou a conexão direta');try{p.restartIce&&p.restartIce();}catch(_){}}pinta();};
  if(V.stream)for(const t of V.stream.getAudioTracks())p.addTrack(t,V.stream);
  else p.addTransceiver('audio',{direction:'recvonly'});
  return p;}
async function conecta(id,oferta){const p=pc(id);
  if(V.stream){const tem=p.getSenders().some(s=>s.track&&s.track.kind==='audio');
    if(!tem){const tr=p.getTransceivers().find(t=>t.receiver&&t.receiver.track&&t.receiver.track.kind==='audio');
      const t0=V.stream.getAudioTracks()[0];if(tr){try{tr.direction='sendrecv';await tr.sender.replaceTrack(t0);}catch(_){p.addTrack(t0,V.stream);}}else p.addTrack(t0,V.stream);}}
  if(oferta){try{const o=await p.createOffer();await p.setLocalDescription(o);sig(id,{tipo:'oferta',sdp:p.localDescription});}catch(e){console.warn('[voz]',e);}}}
async function recebe(m){const id=m.de;if(!id)return;const p=pc(id);
  try{if(m.tipo==='oferta'){
      // as duas pontas ofereceram ao mesmo tempo: a de ID menor cede
      if(p.signalingState!=='stable'){if(eu()<id)return;await p.setLocalDescription({type:'rollback'});}
      await p.setRemoteDescription(m.sdp);const a=await p.createAnswer();await p.setLocalDescription(a);sig(id,{tipo:'resposta',sdp:p.localDescription});}
    else if(m.tipo==='resposta'){if(p.signalingState==='have-local-offer')await p.setRemoteDescription(m.sdp);}
    else if(m.tipo==='ice'&&m.c){try{await p.addIceCandidate(m.c);}catch(_){}}}catch(e){console.warn('[voz]',e);}}
function desbloqueia(){if(!V._bloq)return;for(const k in V.audios)V.audios[k].play().catch(()=>{});V._bloq=false;}
addEventListener('pointerdown',desbloqueia,{capture:true,passive:true});
function medidor(){try{const ac=new (window.AudioContext||window.webkitAudioContext)();const src=ac.createMediaStreamSource(V.stream);const an=ac.createAnalyser();an.fftSize=256;src.connect(an);
  const buf=new Uint8Array(an.frequencyBinCount);setInterval(()=>{an.getByteTimeDomainData(buf);let m=0;for(const v of buf)m=Math.max(m,Math.abs(v-128));const f=m>14;if(f!==V.falando){V.falando=f;pinta();}},150);}catch(_){}}
// liga os ouvintes quando a sala é criada / trocada
let salaLigada=null;
setInterval(()=>{const s=sala();
  if(s&&s!==salaLigada){salaLigada=s;s.onMessage('sig',recebe);
    try{const $=Colyseus.getStateCallbacks(s);$(s.state).jogadores.onAdd((j,id)=>{if(id!==s.sessionId&&V.on)setTimeout(()=>conecta(id,true),400);});
      $(s.state).jogadores.onRemove((j,id)=>{try{V.pcs[id]&&V.pcs[id].close();}catch(_){}delete V.pcs[id];const a=V.audios[id];if(a){a.remove();delete V.audios[id];}});}catch(_){}}
  if(!s&&salaLigada){salaLigada=null;for(const k in V.pcs){try{V.pcs[k].close();}catch(_){}}V.pcs={};}
  pinta();},700);
window.__ocVozBotao=botao;
})();


