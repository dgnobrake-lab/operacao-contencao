function ocSnpcTick(dt){
  const S=OC_SNPC;if(!S.ligado)return;
  S._t+=dt;if(S._t<0.8)return;const passo=S._t;S._t=0;
  if(typeof units==='undefined')return;
  const acao=ocSnpcAcao();
  const F=window.FPS,D=window.OC_DIRECT;
  const lista=[];
  try{if(window.OC_SNIPERS)lista.push(...OC_SNIPERS.list);}catch(_){}
  try{if(window.OC_SNIPER_TC)lista.push(...OC_SNIPER_TC.lista);}catch(_){}
  for(const u of lista){
    if(!u||u.dead||u.inCar||u.wState==='DEAD')continue;
    if((F&&F.on&&F.u===u)||(D&&D.u===u))continue;          // o jogador está no comando deste
    if(u._esc)continue;                                     // subindo
    if(u._lajeEsc){                                         // já está na laje: trabalha
      const alvo=ocSnpcAlvo(u,u.team==='P'?'E':'P');
